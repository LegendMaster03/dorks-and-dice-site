@{
    ViewData["Title"] = "Account deleted";
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card card-body shadow-sm">
            <h1 class="h3">Account deleted</h1>
            <p class="mb-3">Your account credentials and personal account details have been removed, and you have been signed out.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return home</a>
        </div>
    </div>
</div>
