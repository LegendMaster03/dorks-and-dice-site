@{
    ViewData["Title"] = "Check your email";
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card card-body shadow-sm">
            <h1 class="h3">Check your email</h1>
            <p class="mb-3">Your account has been created, but you must confirm your email address before you can log in.</p>
            <p class="mb-0">
                Did not receive the message?
                <a asp-action="ResendConfirmation">Send another confirmation email</a>.
            </p>
        </div>
    </div>
</div>
