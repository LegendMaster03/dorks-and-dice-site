@{
    ViewData["Title"] = "Confirm email";
    ViewData["Robots"] = "noindex,nofollow";
    var succeeded = ViewData["EmailConfirmationSucceeded"] as bool? == true;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card card-body shadow-sm">
            @if (succeeded)
            {
                <h1 class="h3">Email confirmed</h1>
                <p>Your email address has been confirmed. You can now log in.</p>
                <a asp-action="Login" class="btn btn-primary">Log in</a>
            }
            else
            {
                <h1 class="h3">Confirmation link not accepted</h1>
                <p>The confirmation link is invalid or expired.</p>
                <a asp-action="ResendConfirmation" class="btn btn-primary">Send another confirmation email</a>
            }
        </div>
    </div>
</div>
