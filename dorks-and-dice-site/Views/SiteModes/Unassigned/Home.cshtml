@{
    ViewData["Title"] = "Unassigned Site";
    ViewData["MetaTitle"] = "Unassigned Site";
    ViewData["MetaDescription"] = "This domain has not been assigned to a site mode.";
    ViewData["Robots"] = "noindex, nofollow";
}

<section class="py-4">
    <h1 class="mb-3">Unassigned Site</h1>
    <p class="mb-3">
        This domain is connected to the application, but it has not been assigned to a site mode.
    </p>
    <p class="text-muted mb-0">
        Add this host to <code>SiteModeOptions</code> as a professional, Dorks &amp; Dice, or development host when it is
        ready to serve one of the site's configured modes.
    </p>
</section>
