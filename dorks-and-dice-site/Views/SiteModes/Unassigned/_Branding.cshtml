@using dorks_and_dice_site.Models.Site
@using dorks_and_dice_site.Services.Site
@model SiteModeBrandingPart

@if (Model == SiteModeBrandingPart.Header)
{
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
        <div class="container-fluid">
            <span class="navbar-brand fw-semibold">Unassigned Site</span>
        </div>
    </nav>
}
else if (Model == SiteModeBrandingPart.Footer)
{
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <span>&copy; @DateTime.UtcNow.Year Unassigned Site</span>
        </div>
    </div>
}
else
{
    throw new SiteModeBrandingPartUnavailableException(Model);
}
