@using dorks_and_dice_site.Models.Identity
@using dorks_and_dice_site.Models.Site
@using dorks_and_dice_site.Services.Identity
@model DevelopmentPreviewToolbarViewModel
@{
    var host = Context.Request.Host.Host;
    var isLoopbackLocalhost = string.Equals(host, "localhost", StringComparison.OrdinalIgnoreCase)
        || string.Equals(host, "127.0.0.1", StringComparison.OrdinalIgnoreCase)
        || string.Equals(host, "::1", StringComparison.OrdinalIgnoreCase);
    var localSource = Model.ContentSources.FirstOrDefault(source =>
        string.Equals(source.Key, "Local", StringComparison.OrdinalIgnoreCase));
    var externalSource = Model.ContentSources.FirstOrDefault(source =>
        string.Equals(source.Key, "External", StringComparison.OrdinalIgnoreCase));
    var primarySources = new[] { localSource, externalSource }
        .Where(source => source is not null)
        .Where(source => isLoopbackLocalhost || !string.Equals(source!.Key, "Local", StringComparison.OrdinalIgnoreCase))
        .Select(source => source!)
        .ToList();
    var additionalSources = Model.ContentSources
        .Where(source => !string.Equals(source.Key, "Local", StringComparison.OrdinalIgnoreCase))
        .Where(source => !string.Equals(source.Key, "External", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var editorScope = Model.SelectedMode switch
    {
        SiteMode.DorksAndDice => AccountRoleScopes.DorksAndDice,
        SiteMode.Professional => AccountRoleScopes.Professional,
        _ => null
    };
    var canPreviewUnlisted = User.Identity?.IsAuthenticated == true
        && editorScope is not null
        && (User.IsInRole(AccountRoles.Admin)
            || User.HasClaim(
                AccountClaimTypes.ScopedRole,
                $"{editorScope}:{ScopedAccountRoles.Editor}"));
    var showPreviewSettings = canPreviewUnlisted || Model.CanUseDeveloperTools;
}

<div class="development-preview-toolbar border-bottom">
    <div class="container-fluid py-2">
        <div class="d-flex align-items-center gap-3 flex-nowrap">
            <span class="small fw-semibold text-uppercase flex-shrink-0">Trusted Preview</span>
            <form class="d-flex align-items-center gap-2 flex-nowrap mb-0" method="post" action="/development-preview" data-auto-submit="change">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <label class="small text-muted flex-shrink-0" for="siteMode">Mode</label>
                <select class="form-select form-select-sm development-preview-select w-auto" id="siteMode" name="siteMode">
                    <option value="dorks-and-dice" selected="@(Model.SelectedMode == SiteMode.DorksAndDice)">Dorks &amp; Dice</option>
                    <option value="professional" selected="@(Model.SelectedMode == SiteMode.Professional)">Professional</option>
                    <option value="development" selected="@(Model.SelectedMode == SiteMode.Development)">Development</option>
                </select>
            </form>

            @if (showPreviewSettings)
            {
                <div class="dropdown ms-auto flex-shrink-0">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        Preview settings
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3 development-preview-articles-menu">
                        @if (canPreviewUnlisted)
                        {
                            <form method="post" action="/development-preview" data-auto-submit="change" class="mb-3">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <input type="hidden" name="editorPreviewSettings" value="true" />

                                <div class="form-check form-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="includeUnlisted"
                                           name="includeUnlisted"
                                           value="true"
                                           checked="@Model.IncludeUnlistedArticles">
                                    <label class="form-check-label small" for="includeUnlisted">Show unlisted articles</label>
                                </div>
                            </form>
                        }

                        @if (Model.CanUseDeveloperTools)
                        {
                            <form method="post" action="/development-preview" data-auto-submit="change">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <input type="hidden" name="developerPreviewSettings" value="true" />

                                <button class="btn btn-sm btn-outline-secondary w-100 disclosure-toggle"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#developmentContentSources"
                                        aria-expanded="false"
                                        aria-controls="developmentContentSources">
                                    Database sources
                                </button>
                                <div class="collapse mt-2" id="developmentContentSources">
                                    <p class="small text-muted mb-2">
                                        External is the production source boundary. Local is exposed here for localhost authoring and testing.
                                    </p>
                                    @foreach (var source in primarySources)
                                    {
                                        var sourceId = $"contentSource-{source.Key}";
                                        <div class="form-check mb-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@sourceId"
                                                   name="enabledContentSource"
                                                   value="@source.Key"
                                                   checked="@source.IsEnabled" />
                                            <label class="form-check-label small" for="@sourceId">@source.DisplayName</label>
                                        </div>
                                    }
                                    @if (additionalSources.Count > 0)
                                    {
                                        <hr class="my-2" />
                                        @foreach (var source in additionalSources)
                                        {
                                            var sourceId = $"contentSource-{source.Key}";
                                            <div class="form-check mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="@sourceId"
                                                       name="enabledContentSource"
                                                       value="@source.Key"
                                                       checked="@source.IsEnabled" />
                                                <label class="form-check-label small" for="@sourceId">@source.DisplayName</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        @if (Model.RouteRestrictionMismatch)
        {
            <div class="development-preview-warning mt-2" role="alert">
                This page is not available in the selected site mode. A live request would redirect to
                <a asp-controller="Home" asp-action="Index">that mode's homepage</a>.
            </div>
        }
    </div>
</div>
