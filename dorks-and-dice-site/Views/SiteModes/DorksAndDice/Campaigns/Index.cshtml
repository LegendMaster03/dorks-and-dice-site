@model dorks_and_dice_site.Modes.DorksAndDice.Ui.CampaignsIndexViewModel
@{
    ViewData["Title"] = "Campaigns";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">Dorks &amp; Dice</p>
            <h1 class="h2 mb-2">Campaigns</h1>
            <p class="text-muted mb-0">Campaign membership, DM authority, participants, and character connections live here.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Characters" asp-action="Index">My Characters</a>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Create campaign</h2>
            <form asp-controller="Campaigns" asp-action="Create" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-8">
                    <label class="form-label" for="campaignName">Campaign name</label>
                    <input id="campaignName" class="form-control" type="text" name="name" maxlength="160" required />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100" type="submit">Create Campaign</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Campaigns.Count == 0)
    {
        <div class="alert alert-secondary">
            You are not currently part of any campaigns. Create one above to become its first DM.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var campaign in Model.Campaigns)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5">@campaign.Name</h2>
                            <div class="mb-3">
                                @foreach (var role in campaign.Roles)
                                {
                                    <span class="badge text-bg-secondary me-1">@role.ToUpperInvariant()</span>
                                }
                            </div>
                            <a class="btn btn-outline-primary mt-auto"
                               asp-controller="Campaigns"
                               asp-action="Details"
                               asp-route-campaignId="@campaign.Id">Open Campaign</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
