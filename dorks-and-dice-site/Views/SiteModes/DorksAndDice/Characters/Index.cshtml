@model dorks_and_dice_site.Modes.DorksAndDice.Ui.CharactersIndexViewModel
@{
    ViewData["Title"] = "Characters";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">Dorks &amp; Dice</p>
            <h1 class="h2 mb-2">My Characters</h1>
            <p class="text-muted mb-0">Characters belong to your account. Campaign connections are independent and remain historical when they end.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Campaigns" asp-action="Index">Campaigns</a>
    </div>

    @if (TempData["CharacterError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm mb-4"><div class="card-body">
        <h2 class="h5">Create character</h2>
        <form asp-controller="Characters" asp-action="Create" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-8"><label class="form-label" for="characterName">Character name</label><input id="characterName" class="form-control" type="text" name="name" maxlength="160" required /></div>
            <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Create Character</button></div>
        </form>
    </div></div>

    <h2 class="h4 mb-3">Active characters</h2>
    @if (Model.ActiveCharacters.Count == 0)
    {
        <div class="alert alert-secondary">You have no active characters.</div>
    }
    else
    {
        <div class="row g-3 mb-5">
        @foreach (var character in Model.ActiveCharacters)
        {
            var connectedIds = character.ActiveCampaigns.Select(connection => connection.CampaignId).ToHashSet();
            var availableCampaigns = Model.PlayerCampaigns.Where(campaign => !connectedIds.Contains(campaign.Id)).ToArray();
            <div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-body">
                <form asp-controller="Characters" asp-action="Rename" asp-route-characterId="@character.Id" method="post" class="d-flex gap-2 align-items-center mb-3">
                    @Html.AntiForgeryToken()<label class="visually-hidden" for="name-@character.Id">Character name</label><input id="name-@character.Id" class="form-control fw-semibold" type="text" name="name" value="@character.Name" maxlength="160" required /><button class="btn btn-sm btn-outline-primary" type="submit">Rename</button>
                </form>
                @if (character.ActiveCampaigns.Count > 0)
                {
                    <p class="small text-muted mb-2">Active campaign connections</p>
                    <div class="list-group list-group-flush mb-3">
                    @foreach (var connection in character.ActiveCampaigns)
                    {
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2"><a asp-controller="Campaigns" asp-action="Details" asp-route-campaignId="@connection.CampaignId">@connection.CampaignName</a><form asp-controller="Characters" asp-action="Disconnect" asp-route-characterId="@character.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="campaignId" value="@connection.CampaignId" /><button class="btn btn-sm btn-outline-secondary" type="submit">Disconnect</button></form></div>
                    }
                    </div>
                }
                else { <p class="text-muted small">Not currently connected to a campaign.</p> }

                @if (availableCampaigns.Length > 0)
                {
                    <form asp-controller="Characters" asp-action="Connect" asp-route-characterId="@character.Id" method="post" class="row g-2 mb-3">@Html.AntiForgeryToken()<div class="col-sm-8"><label class="visually-hidden" for="campaign-@character.Id">Campaign</label><select id="campaign-@character.Id" class="form-select" name="campaignId" required><option value="">Add campaign connection</option>@foreach (var campaign in availableCampaigns) { <option value="@campaign.Id">@campaign.Name</option> }</select></div><div class="col-sm-4"><button class="btn btn-outline-primary w-100" type="submit">Connect</button></div></form>
                }
                else if (Model.PlayerCampaigns.Count == 0) { <p class="text-muted">Join a campaign with the Player role to connect this character.</p> }

                <form asp-controller="Characters" asp-action="Archive" asp-route-characterId="@character.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Archive Character</button></form>
            </div></div></div>
        }
        </div>
    }

    @if (Model.ArchivedCharacters.Count > 0)
    {
        <h2 class="h4 mb-3">Archived characters</h2>
        <div class="row g-3">
        @foreach (var character in Model.ArchivedCharacters)
        {
            <div class="col-lg-6"><div class="card h-100 border-secondary"><div class="card-body">
                <div class="d-flex justify-content-between gap-2 mb-2"><h3 class="h5">@character.Name</h3><span class="badge text-bg-secondary align-self-start">Archived</span></div>
                @if (character.ArchivedAt is DateTimeOffset archivedAt) { <p class="small text-muted">Archived @archivedAt.ToLocalTime().ToString("g"). Restoring does not reconnect previous campaigns.</p> }
                <div class="d-flex flex-wrap gap-2">
                    <form asp-controller="Characters" asp-action="Restore" asp-route-characterId="@character.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-primary" type="submit">Restore</button></form>
                    <form asp-controller="Characters" asp-action="Rename" asp-route-characterId="@character.Id" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input class="form-control form-control-sm" type="text" name="name" value="@character.Name" maxlength="160" required /><button class="btn btn-sm btn-outline-primary" type="submit">Rename</button></form>
                </div>
            </div></div></div>
        }
        </div>
    }
</div>
