@model dorks_and_dice_site.Modes.DorksAndDice.Ui.CharactersIndexViewModel
@{
    ViewData["Title"] = "Characters";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">Dorks &amp; Dice</p>
            <h1 class="h2 mb-2">My Characters</h1>
            <p class="text-muted mb-0">Characters belong to your account. Campaign connections can end without transferring or deleting them.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Campaigns" asp-action="Index">Campaigns</a>
    </div>

    @if (TempData["CharacterError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Create character</h2>
            <p class="text-muted small">This creates the account-owned character identity. Character-sheet data will remain owned by the Character Sheet tool.</p>
            <form asp-controller="Characters" asp-action="Create" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-8">
                    <label class="form-label" for="characterName">Character name</label>
                    <input id="characterName" class="form-control" type="text" name="name" maxlength="160" required />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100" type="submit">Create Character</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Characters.Count == 0)
    {
        <div class="alert alert-secondary">You have not created any characters yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var character in Model.Characters)
            {
                <div class="col-lg-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">@character.Name</h2>
                            @if (character.ActiveCampaignId is Guid activeCampaignId)
                            {
                                <p class="mb-3">
                                    Connected to
                                    <a asp-controller="Campaigns" asp-action="Details" asp-route-campaignId="@activeCampaignId">
                                        @(character.ActiveCampaignName ?? "Campaign")
                                    </a>
                                </p>
                                <form asp-controller="Characters"
                                      asp-action="Disconnect"
                                      asp-route-characterId="@character.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="campaignId" value="@activeCampaignId" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Disconnect from Campaign</button>
                                </form>
                            }
                            else if (Model.PlayerCampaigns.Count > 0)
                            {
                                <p class="text-muted small">Not currently connected to a campaign.</p>
                                <form asp-controller="Characters"
                                      asp-action="Connect"
                                      asp-route-characterId="@character.Id"
                                      method="post"
                                      class="row g-2">
                                    @Html.AntiForgeryToken()
                                    <div class="col-sm-8">
                                        <label class="visually-hidden" for="campaign-@character.Id">Campaign</label>
                                        <select id="campaign-@character.Id" class="form-select" name="campaignId" required>
                                            <option value="">Choose campaign</option>
                                            @foreach (var campaign in Model.PlayerCampaigns)
                                            {
                                                <option value="@campaign.Id">@campaign.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-4">
                                        <button class="btn btn-outline-primary w-100" type="submit">Connect</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Not connected. Join a campaign with the Player role to connect this character.</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
