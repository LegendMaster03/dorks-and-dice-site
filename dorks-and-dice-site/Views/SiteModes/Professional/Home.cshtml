@model dorks_and_dice_site.Models.Resume.ResumeViewModel
@using dorks_and_dice_site.Models.Content
@{
    ViewData["Title"] = "Resume";
    ViewData["MetaTitle"] = "Kyle Barnett Resume";
    ViewData["MetaDescription"] = "Professional resume for Kyle Barnett: experience, education, and selected projects.";
    ViewData["MetaImage"] = Url.Content(Model.Header.HeadshotImageUrl);
    var orderedProjects = Model.ProjectItems
        .Select((project, index) => new { Project = project, Index = index })
        .OrderByDescending(item => item.Project.IsFeatured(ContentTags.Project))
        .ThenBy(item => item.Index)
        .Select(item => item.Project)
        .ToList();
    var projectTags = orderedProjects
        .SelectMany(project => project.PublicTags)
        .Where(tag => !string.IsNullOrWhiteSpace(tag))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();
    Func<string, string> formatTagLabel = tag => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(tag.Replace("-", " "));
}

<section class="resume-section mb-4" id="header-section">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-8 d-flex">
            <div class="resume-hero-main d-flex align-items-stretch gap-3 flex-grow-1 flex-wrap flex-md-nowrap">
                <img src="@Url.Content(Model.Header.HeadshotImageUrl)"
                     class="profile-headshot profile-headshot-hero img-fluid rounded-circle border"
                     alt="@Model.Header.HeadshotAltText"
                     width="613"
                     height="613" />
                <div class="resume-identity">
                    <h1 class="mb-1">@Model.Header.FullName</h1>
                    <p class="mb-1">@Model.Header.Headline</p>
                    <p class="text-muted mb-3">@Model.Header.Location</p>
                    <p class="mb-0">
                        Download PDF: <a class="fw-semibold" href="@Url.Content(Model.Header.ResumePdfUrl)" download>@Model.Header.ResumePdfFileName</a>
                    </p>
                    <p class="text-muted small mb-0 mt-2">Last updated: @Model.Header.LastUpdatedText</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <aside id="contact" class="contact-card p-3 rounded-3 border h-100">
                <h2 class="h6 text-uppercase mb-3">Contact</h2>
                @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_ContactLinks.cshtml", Model.ContactLinks)
            </aside>
        </div>
    </div>
</section>

<section class="resume-section mb-4" id="summary-section">
    <div class="card">
        <div class="card-body">
            <h2 class="h5 resume-section-title">Professional Summary</h2>
            <p class="mb-0">
                Software developer and technology generalist with experience delivering client applications,
                managing small-business technology, competing in cybersecurity, and building tools for games
                and legacy software. I work across software, systems, and client needs, translating technical
                problems into practical solutions.
            </p>
        </div>
    </div>
</section>

<nav class="resume-section-nav mb-4" aria-label="Resume section navigation">
    <a href="#experience-section">Experience</a>
    <a href="#projects-section">Projects</a>
    <a href="#skills-section">Skills</a>
    <a href="#education-section">Education</a>
    <a href="#honors-section">Honors</a>
    <a href="#leadership-section">Leadership</a>
</nav>

<section class="resume-section mb-4" id="experience-section">
    <h2 class="h4 resume-section-title">Experience</h2>
    @foreach (var experience in Model.ExperienceItems)
    {
        @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_ExperienceCard.cshtml", experience)
    }
</section>

<section class="resume-section mb-4" id="projects-section">
    <h2 class="h4 resume-section-title" id="projects">Projects</h2>
    <p class="text-muted mb-3">Selected portfolio work, with featured projects shown first.</p>

    <div id="projectFilters" class="article-filters mb-3">
        <label class="form-label visually-hidden" for="projectSearch">Search projects</label>
        <input id="projectSearch"
               type="search"
               class="form-control form-control-sm article-search"
               placeholder="Search projects or tags"
               autocomplete="off"
               list="projectTagSuggestions" />
        <datalist id="projectTagSuggestions">
            @foreach (var tag in projectTags)
            {
                <option value="@tag">@formatTagLabel(tag)</option>
            }
        </datalist>
        <div class="d-flex flex-wrap gap-2" aria-label="Project tags">
            <button type="button" class="btn btn-sm btn-outline-secondary active" data-filter-tag="all">All</button>
            @foreach (var tag in projectTags)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filter-tag="@tag">@formatTagLabel(tag)</button>
            }
        </div>
    </div>
    <p id="projectFilterStatus" class="visually-hidden" role="status" aria-live="polite"></p>

    <div id="projectList" class="row row-cols-1 row-cols-md-2 g-4 mt-1">
        @foreach (var project in orderedProjects)
        {
            @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_ProjectCard.cshtml", project)
        }
    </div>
</section>

<section class="resume-section mb-4" id="skills-section">
    <h2 class="h4 resume-section-title">Skills</h2>
    <div class="card">
        <div class="card-body">
            @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_SkillsSection.cshtml", Model.SkillCategories)
        </div>
    </div>
</section>

<!-- Credentials are embedded inline inside relevant Education / Honors entries -->

<section class="resume-section mb-4" id="education-section">
    <h2 class="h4 resume-section-title">Education</h2>
    @foreach (var educationEntry in Model.EducationEntries)
    {
        @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_EducationEntry.cshtml", educationEntry)
    }
</section>

<section class="resume-section mb-4" id="honors-section">
    <h2 class="h4 resume-section-title">Honors &amp; Awards</h2>
    @foreach (var awardEntry in Model.AwardEntries)
    {
        @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_AwardEntry.cshtml", awardEntry)
    }
</section>

<section class="resume-section" id="leadership-section">
    <h2 class="h4 resume-section-title">Leadership Experience</h2>
    @foreach (var leadershipEntry in Model.LeadershipEntries)
    {
        @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_LeadershipEntry.cshtml", leadershipEntry)
    }
</section>
