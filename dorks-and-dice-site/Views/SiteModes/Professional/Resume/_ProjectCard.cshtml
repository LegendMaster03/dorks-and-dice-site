@model dorks_and_dice_site.Models.Resume.ProjectItemViewModel
@{
    var categoryLabel = string.Equals(Model.Category, "professional", StringComparison.OrdinalIgnoreCase)
        ? "Professional"
        : string.Equals(Model.Category, "personal", StringComparison.OrdinalIgnoreCase)
            ? "Personal"
            : Model.Category;
    var projectLinkText = string.IsNullOrWhiteSpace(Model.LinkText) ? "Open project" : Model.LinkText;
    var projectSearchText = $"{Model.Title} {Model.Subtitle} {Model.Summary} {string.Join(' ', Model.Tags)}".ToLowerInvariant();
}

<div class="col project-card"
     data-category="@Model.Category"
     data-featured="@(Model.Featured ? "true" : "false")"
     data-tags="@string.Join(' ', Model.Tags)"
     data-title="@Model.Title.ToLowerInvariant()"
     data-search="@projectSearchText">
    <div class="card h-100 project-card-inner @(Model.Featured ? "project-card-featured" : string.Empty)">
        <div class="card-body">
            <div class="project-card-header">
                <div class="project-card-heading">
                    <div class="project-card-meta mb-2">
                        <span class="badge text-bg-light border">@categoryLabel</span>
                        @if (Model.Featured)
                        {
                            <span class="badge featured-badge">Featured</span>
                        }
                    </div>
                    <h2 class="h5 card-title">@Model.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                    {
                        <p class="project-card-subtitle text-muted mb-2">@Model.Subtitle</p>
                    }
                </div>
                <div class="project-card-actions">
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="@Model.DetailsController"
                       asp-action="@Model.Action"
                       aria-label="@projectLinkText: @Model.Title">
                        @projectLinkText
                    </a>
                    @if (!string.IsNullOrWhiteSpace(Model.RepositoryUrl))
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           href="@Model.RepositoryUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="View Git repository for @Model.Title (opens in a new tab)">
                            View Git
                        </a>
                    }
                </div>
            </div>
            <p class="card-text">@Model.Summary</p>
            @if (Model.Tags.Count > 0)
            {
                <p class="project-card-tags mb-3">
                    @for (var i = 0; i < Model.Tags.Count; i++)
                    {
                        <span class="badge rounded-pill text-bg-secondary-subtle text-secondary-emphasis">@Model.Tags[i]</span>
                    }
                </p>
            }
        </div>
    </div>
</div>
