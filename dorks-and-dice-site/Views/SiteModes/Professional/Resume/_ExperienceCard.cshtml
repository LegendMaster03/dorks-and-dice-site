@model dorks_and_dice_site.Models.Content.ContentItem
@using dorks_and_dice_site.Models.Content
@{
    var title = Model.GetTitle(ContentTags.Experience);
    var dateText = Model.GetDateText(ContentTags.Experience) ?? string.Empty;
    var highlights = Model.GetHighlights(ContentTags.Experience);
    var featured = Model.IsFeatured(ContentTags.Experience);
    var linkText = Model.GetLinkText(ContentTags.Experience);
}

<div class="card mb-2" data-tags="@string.Join(' ', Model.PublicTags)">
    <div class="card-body">
        <div class="resume-entry-header">
            <div class="resume-entry-heading">
                <h3 class="h6 mb-1">@title</h3>
                <p class="resume-entry-meta text-muted mb-2">
                    <span>@dateText</span>
                    @if (featured)
                    {
                        <span class="badge text-bg-primary">Featured</span>
                    }
                </p>
            </div>
            <div class="resume-entry-actions">
                <a class="btn btn-sm btn-outline-primary resume-entry-action" href="/resume/@Model.Slug">
                    @linkText
                </a>
            </div>
        </div>
        @if (highlights.Count > 0)
        {
            <ul class="mb-0">
                @foreach (var highlight in highlights)
                {
                    <li>@highlight</li>
                }
            </ul>
        }
    </div>
</div>
