@{
    ViewData["Title"] = "Experience: Independent Technology Consulting";
    var header = new dorks_and_dice_site.Models.Resume.ResumeDetailHeaderViewModel
    {
        Title = "Independent Technology Consultant",
        Subtitle = "Private Clients",
        MetaLine = "2019 - Present | Jacksonville and Ponte Vedra Beach, FL"
    };
}

@await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_ResumeDetailHeader.cshtml", header)

<p>
    I provide ongoing technology consulting and support to a small group of private clients.
    Most of this work comes from two long-term client relationships, supplemented by one-time
    engagements and referrals. I learn each client's environment, help plan technology changes,
    and remain available as needs evolve.
</p>

<section class="mt-4">
    <h2 class="h5">Services</h2>
    <ul>
        <li>Computer and mobile-device migrations.</li>
        <li>Software installation, upgrades, and troubleshooting.</li>
        <li>Account recovery and organization.</li>
        <li>Data transfer and organization.</li>
        <li>Purchasing and replacement recommendations.</li>
        <li>Small-network and peripheral support.</li>
        <li>Vendor and service-provider coordination.</li>
        <li>User education and workflow improvements.</li>
    </ul>
</section>

<section class="mt-4">
    <h2 class="h5">Working Approach</h2>
    <p>
        The work emphasizes long-term trust, responsive follow-up, and clear explanations tailored
        to each client's technical comfort. The goal is to provide practical solutions rather than
        introduce unnecessary complexity.
    </p>
</section>

<section class="mt-4">
    <h2 class="h5">Platforms and Technologies</h2>
    <p class="mb-0">
        Windows, macOS, iOS, consumer networking, cloud accounts, data migration, software updates,
        peripherals, purchasing guidance, troubleshooting, and vendor coordination.
    </p>
</section>
