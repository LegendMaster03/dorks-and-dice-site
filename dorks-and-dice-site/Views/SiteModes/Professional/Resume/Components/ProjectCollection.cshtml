@model IReadOnlyList<dorks_and_dice_site.Models.Content.ContentItem>
@{
    var projectTags = Model
        .SelectMany(project => project.PublicTags)
        .Where(tag => !string.IsNullOrWhiteSpace(tag))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();
    Func<string, string> formatTagLabel = tag => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(tag.Replace("-", " "));
}

<div id="projectFilters"
     class="article-filters mb-3"
     data-content-filter
     data-content-search="projectSearch"
     data-content-list="projectList"
     data-content-status="projectFilterStatus"
     data-content-label="project">
    <label class="form-label visually-hidden" for="projectSearch">Search projects</label>
    <input id="projectSearch"
           type="search"
           class="form-control form-control-sm article-search"
           placeholder="Search projects or tags"
           autocomplete="off"
           list="projectTagSuggestions" />
    <datalist id="projectTagSuggestions">
        @foreach (var tag in projectTags)
        {
            <option value="@tag">@formatTagLabel(tag)</option>
        }
    </datalist>
    <div class="d-flex flex-wrap gap-2" aria-label="Project tags">
        <button type="button" class="btn btn-sm btn-outline-secondary active" data-content-tag="all">All</button>
        @foreach (var tag in projectTags)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-content-tag="@tag">@formatTagLabel(tag)</button>
        }
    </div>
</div>
<p id="projectFilterStatus" class="visually-hidden" role="status" aria-live="polite"></p>

<div id="projectList" class="row row-cols-1 row-cols-md-2 g-4 mt-1">
    @foreach (var project in Model)
    {
        @await Html.PartialAsync("~/Views/SiteModes/Professional/Resume/_ProjectCard.cshtml", project)
    }
</div>
