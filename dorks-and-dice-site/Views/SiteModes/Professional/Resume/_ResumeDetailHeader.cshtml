@model dorks_and_dice_site.Models.Resume.ResumeDetailHeaderViewModel
@{
    var isExperienceDetail = Model.Title.StartsWith("Experience:", StringComparison.OrdinalIgnoreCase);
    var backLinkText = isExperienceDetail ? "Back to experience" : "Back to projects";
    var backLinkFragment = isExperienceDetail ? "experience-section" : "projects-section";
}

<nav class="resume-detail-back mb-3" aria-label="Detail navigation">
    <a class="btn btn-sm btn-outline-primary"
       asp-controller="Resume"
       asp-action="Index"
       asp-fragment="@backLinkFragment">
        &larr; @backLinkText
    </a>
</nav>

<style>
    .resume-detail-header {
        display: block;
    }

    .resume-detail-heading {
        --detail-logo-share: 20%;
        position: relative;
        box-sizing: border-box;
        min-width: 0;
        padding-right: calc(var(--detail-logo-share) + 1rem);
    }

    .resume-detail-heading h1 {
        overflow-wrap: anywhere;
    }

    .resume-detail-heading .resume-detail-logo-link {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: var(--detail-logo-share);
        min-width: 0;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
    }

    .resume-detail-heading .resume-detail-logo {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: top right;
    }

    .resume-detail-heading .resume-detail-logo-link[href="https://consolevariations.com/"]
    img[src$="consolevariations-bee.png"] {
        width: min(92px, 100%);
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: contain;
    }

    @media (max-width: 575.98px) {
        .resume-detail-heading {
            --detail-logo-share: 15%;
        }
    }
</style>

<div class="resume-detail-header mb-3">
    <div class="resume-detail-heading">
        <h1 class="mb-1">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="text-muted mb-1">@Model.Subtitle</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.MetaLine))
        {
            <p class="resume-detail-meta text-muted mb-0">@Model.MetaLine</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LogoUrl) && !string.IsNullOrWhiteSpace(Model.LogoLinkUrl))
        {
            <a href="@Model.LogoLinkUrl"
               class="resume-detail-logo-link"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="@(string.IsNullOrWhiteSpace(Model.LogoAriaLabel) ? "Organization website" : Model.LogoAriaLabel)">
                <img src="@Model.LogoUrl"
                     class="experience-logo resume-detail-logo"
                     alt="@(string.IsNullOrWhiteSpace(Model.LogoAltText) ? "Organization logo" : Model.LogoAltText)" />
            </a>
        }
    </div>
</div>

@if (Model.InfoItems.Count > 0)
{
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase mb-3">Project Information</h2>
            <dl class="row mb-0">
                @foreach (var item in Model.InfoItems)
                {
                    <dt class="col-sm-3">@item.Key</dt>
                    <dd class="col-sm-9">
                        @if (Model.InfoItemLinks.TryGetValue(item.Key, out var itemLink) && !string.IsNullOrWhiteSpace(itemLink))
                        {
                            <a href="@itemLink" target="_blank" rel="noopener noreferrer">@item.Value</a>
                        }
                        else
                        {
                            @item.Value
                        }
                    </dd>
                }
            </dl>
        </div>
    </section>
}
