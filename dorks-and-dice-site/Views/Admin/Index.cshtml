@model dorks_and_dice_site.Models.Content.ContentAuthoringEditViewModel
@using dorks_and_dice_site.Models.Identity
@using dorks_and_dice_site.Models.Site
@using dorks_and_dice_site.Services.Identity
@using dorks_and_dice_site.Services.Site
@{
    var document = Model.Document;
    var isGlobalEditor = User.IsInRole(AccountRoles.Admin);
    var editorMode = Context.GetSiteModeContext().SiteMode;
    var editorScopeLabel = editorMode switch
    {
        SiteMode.DorksAndDice => "Dorks & Dice",
        SiteMode.Professional => "Professional",
        _ => editorMode.ToString()
    };
    ViewData["Title"] = document.IsNew ? "New Content" : $"Edit {document.Id}";
    ViewData["Robots"] = "noindex, nofollow";
    var saveAction = document.IsNew
        ? "/editor/content/new"
        : $"/editor/content/{document.Slug}/edit";
    var tagValues = document.TagsText
        .Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var hasArticleTag = tagValues.Any(tag => string.Equals(tag, dorks_and_dice_site.Models.Content.ContentTags.Article, StringComparison.OrdinalIgnoreCase));
    var hasProjectTag = tagValues.Any(tag => string.Equals(tag, dorks_and_dice_site.Models.Content.ContentTags.Project, StringComparison.OrdinalIgnoreCase));
    var hasExperienceTag = tagValues.Any(tag => string.Equals(tag, dorks_and_dice_site.Models.Content.ContentTags.Experience, StringComparison.OrdinalIgnoreCase));
    var detailHref = hasArticleTag
        ? $"/articles/{document.Slug}"
        : hasExperienceTag && !hasProjectTag
            ? $"/resume/{document.Slug}?context=experience"
            : $"/resume/{document.Slug}";
    var selectableModes = Enum.GetValues<SiteMode>()
        .Where(mode => mode is not SiteMode.Development and not SiteMode.Unassigned)
        .ToList();
    IEnumerable<string> selectedModeValues = document.VisibleModesSelection.Count > 0
        ? document.VisibleModesSelection
        : document.VisibleModesText.Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var selectedModes = selectedModeValues.ToHashSet(StringComparer.OrdinalIgnoreCase);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-uppercase text-muted small mb-1">Editor · @(isGlobalEditor ? "All site scopes" : editorScopeLabel)</p>
        <h1 class="h3 mb-0">@(document.IsNew ? "New content page" : $"Edit {document.Id}")</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (!document.IsNew)
        {
            <a class="btn btn-outline-primary" href="@detailHref">View page</a>
            <a class="btn btn-outline-primary" href="/editor/content/@document.Slug/media">Media dependencies</a>
        }
        <a class="btn btn-outline-secondary" href="/editor/content">Back to content</a>
    </div>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form method="post" action="@saveAction">
    @Html.AntiForgeryToken()
    <input asp-for="Document.IsNew" type="hidden" />
    <input asp-for="Document.ExpectedRevisionId" type="hidden" />

    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Document.IsListed" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="Document.IsListed" class="form-check-label">Listed</label>
            <div class="form-text">Unlisted content is hidden from indexes and renders noindex.</div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Document.Id" class="form-label">Stable ID</label>
            <input asp-for="Document.Id" class="form-control" readonly="@(!document.IsNew)" />
            <div class="form-text">Stable internal identity. Existing page IDs do not change across revisions.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="Document.Slug" class="form-label">Slug</label>
            <input asp-for="Document.Slug" class="form-control" />
            <div class="form-text">Public detail-route segment. Changing it moves the current route while retaining page identity.</div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <label asp-for="Document.TagsText" class="form-label">Tags</label>
            <textarea asp-for="Document.TagsText" class="form-control font-monospace" rows="7"></textarea>
            <div class="form-text">One per line or comma-separated. Include context tags here; use the Listed toggle instead of _internal:unlisted.</div>
        </div>
        <div class="col-lg-6">
            <label class="form-label">Visible site modes</label>
            @if (isGlobalEditor)
            {
                <input asp-for="Document.VisibleModesText" type="hidden" value="" />
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button"
                            id="visible-mode-dropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <span id="visible-mode-summary">Select visible modes</span>
                    </button>
                    <div class="dropdown-menu w-100 p-3" aria-labelledby="visible-mode-dropdown">
                        @foreach (var mode in selectableModes)
                        {
                            var modeName = mode.ToString();
                            <div class="form-check">
                                <input class="form-check-input content-visible-mode" type="checkbox"
                                       name="Document.VisibleModesSelection" value="@modeName" id="visible-mode-@modeName"
                                       checked="@(selectedModes.Contains(modeName))" />
                                <label class="form-check-label" for="visible-mode-@modeName">@modeName</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="form-text">As head editor, Admin may target one or more public site modes.</div>
            }
            else
            {
                <input type="hidden" name="Document.VisibleModesText" value="@editorMode" />
                <input type="hidden" name="Document.VisibleModesSelection" value="@editorMode" />
                <input class="form-control" value="@editorScopeLabel" readonly />
                <div class="form-text">Your Editor role is scoped to this site. Cross-site content is managed by an Admin.</div>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Document.MetadataJson" class="form-label">Revision metadata</label>
        <div class="btn-group d-block mb-2" role="group" aria-label="Metadata editing mode">
            <button class="btn btn-outline-secondary" id="metadata-standard-tab" type="button">Standard</button>
            <button class="btn btn-outline-secondary active" id="metadata-source-tab" type="button">Source</button>
        </div>
        <div id="metadata-standard-editor" class="card card-body d-none">
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label">Title</label><input class="form-control" data-meta-path="title" data-meta-required="true" /></div>
                <div class="col-md-4"><label class="form-label">Date text</label><input class="form-control" data-meta-path="dateText" /></div>
                <div class="col-md-6"><label class="form-label">Subtitle</label><input class="form-control" data-meta-path="subtitle" /></div>
                <div class="col-md-3"><label class="form-label">Category</label><input class="form-control" data-meta-path="category" /></div>
                <div class="col-md-3"><label class="form-label">Link text</label><input class="form-control" data-meta-path="linkText" data-meta-required="true" /></div>
                <div class="col-12"><label class="form-label">Summary</label><textarea class="form-control" rows="3" data-meta-path="summary" data-meta-required="true"></textarea></div>
                <div class="col-md-9"><label class="form-label">Repository URL</label><input class="form-control" type="url" data-meta-path="repositoryUrl" /></div>
                <div class="col-md-3 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" data-meta-path="featured" id="metadata-featured" /><label class="form-check-label" for="metadata-featured">Featured</label></div></div>
                <div class="col-12"><label class="form-label">Highlights</label><textarea class="form-control" rows="5" data-meta-path="highlights" data-meta-list="true"></textarea><div class="form-text">One highlight per line.</div></div>
            </div>

            <hr />
            <h2 class="h6">Search and sharing metadata</h2>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Meta title</label><input class="form-control" data-meta-path="metaTitle" /></div>
                <div class="col-md-6"><label class="form-label">Meta image URL</label><input class="form-control" data-meta-path="metaImage" /></div>
                <div class="col-12"><label class="form-label">Meta description</label><textarea class="form-control" rows="2" data-meta-path="metaDescription"></textarea></div>
            </div>

            <hr />
            <h2 class="h6">Listing image</h2>
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label">Image URL</label><input class="form-control" data-meta-path="listingImage.url" /></div>
                <div class="col-md-4"><label class="form-label">Alt text</label><input class="form-control" data-meta-path="listingImage.altText" /></div>
                <div class="col-md-3"><label class="form-label">Width</label><input class="form-control" type="number" min="0" data-meta-path="listingImage.width" data-meta-number="true" /></div>
                <div class="col-md-3"><label class="form-label">Height</label><input class="form-control" type="number" min="0" data-meta-path="listingImage.height" data-meta-number="true" /></div>
            </div>

            <hr />
            <h2 class="h6">Detail header</h2>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Meta line</label><input class="form-control" data-meta-path="header.metaLine" /></div>
                <div class="col-md-6"><label class="form-label">CSS class</label><input class="form-control" data-meta-path="header.cssClass" /></div>
                <div class="col-md-6"><label class="form-label">Logo URL</label><input class="form-control" data-meta-path="header.logoUrl" /></div>
                <div class="col-md-6"><label class="form-label">Logo alt text</label><input class="form-control" data-meta-path="header.logoAltText" /></div>
                <div class="col-md-6"><label class="form-label">Logo link URL</label><input class="form-control" data-meta-path="header.logoLinkUrl" /></div>
                <div class="col-md-6"><label class="form-label">Logo link label</label><input class="form-control" data-meta-path="header.logoAriaLabel" /></div>
            </div>

            <hr />
            <h2 class="h6">Context presentations</h2>
            <div class="accordion" id="metadata-presentations">
                @foreach (var contextName in new[] { "project", "experience", "article" })
                {
                    <div class="accordion-item">
                        <h3 class="accordion-header"><button class="accordion-button collapsed text-capitalize" type="button" data-bs-toggle="collapse" data-bs-target="#metadata-presentation-@contextName">@contextName</button></h3>
                        <div id="metadata-presentation-@contextName" class="accordion-collapse collapse" data-bs-parent="#metadata-presentations">
                            <div class="accordion-body row g-3">
                                <div class="col-md-6"><label class="form-label">Title override</label><input class="form-control" data-meta-path="@($"presentations.{contextName}.title")" /></div>
                                <div class="col-md-6"><label class="form-label">Subtitle override</label><input class="form-control" data-meta-path="@($"presentations.{contextName}.subtitle")" /></div>
                                <div class="col-md-4"><label class="form-label">Date override</label><input class="form-control" data-meta-path="@($"presentations.{contextName}.dateText")" /></div>
                                <div class="col-md-4"><label class="form-label">Category override</label><input class="form-control" data-meta-path="@($"presentations.{contextName}.category")" /></div>
                                <div class="col-md-4"><label class="form-label">Link text override</label><input class="form-control" data-meta-path="@($"presentations.{contextName}.linkText")" /></div>
                                <div class="col-md-4"><label class="form-label">Featured override</label><select class="form-select" data-meta-path="@($"presentations.{contextName}.featured")" data-meta-nullable-bool="true"><option value="">Inherit</option><option value="true">Featured</option><option value="false">Not featured</option></select></div>
                                <div class="col-12"><label class="form-label">Summary override</label><textarea class="form-control" rows="2" data-meta-path="@($"presentations.{contextName}.summary")"></textarea></div>
                                <div class="col-12"><label class="form-label">Highlight overrides</label><textarea class="form-control" rows="4" data-meta-path="@($"presentations.{contextName}.highlights")" data-meta-list="true"></textarea></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="form-text mt-3">Advanced header information dictionaries and any future schema fields are preserved and remain editable in Source mode.</div>
        </div>
        <div id="metadata-source-editor">
            <textarea asp-for="Document.MetadataJson" class="form-control font-monospace" rows="30" spellcheck="false"></textarea>
            <div class="form-text">Complete canonical metadata JSON for advanced or precise edits.</div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Document.BodyFormat" class="form-label">Body format</label>
        <select asp-for="Document.BodyFormat" class="form-select">
            <option value="markdown">Markdown</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Document.Body" class="form-label">Body</label>
        <div class="btn-group mb-2" role="group" aria-label="Body editing mode">
            <button class="btn btn-outline-secondary active" id="content-source-tab" type="button">Source</button>
            <button class="btn btn-outline-secondary" id="content-visual-tab" type="button">Visual</button>
        </div>
        <textarea asp-for="Document.Body" class="form-control font-monospace" rows="34" spellcheck="true"></textarea>
        <div id="content-visual-editor" class="d-none">
            <div class="btn-toolbar gap-1 mb-2" role="toolbar" aria-label="Visual editor formatting">
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-block="h2">Heading</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-command="bold"><strong>Bold</strong></button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-command="italic"><em>Italic</em></button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-command="insertUnorderedList">List</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-command="insertOrderedList">Numbered list</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-action="link">Link</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-action="image">Image</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-block="blockquote">Quote</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-block="pre">Code block</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-visual-action="table">Table</button>
            </div>
            <div id="content-visual-surface" class="form-control content-visual-surface" contenteditable="true" spellcheck="true"></div>
            <div class="form-text">Visual mode supports standard Markdown structures. Directives are protected blocks. Changes are converted back to Markdown before preview or save.</div>
        </div>
        <div class="form-text">Markdown is the authored format. Raw HTML is disabled. Registered <code>{{directive}}</code> blocks are supported. Use Media dependencies for content-owned media.</div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-primary" type="submit">@(document.IsNew ? "Create page" : "Save revision")</button>
        <button class="btn btn-outline-secondary" type="submit" formaction="/editor/content/preview">Preview body</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.RenderedPreviewHtml))
{
    <section class="card mb-4">
        <div class="card-header">Body preview</div>
        <div class="card-body content-detail-body">
            @Html.Raw(Model.RenderedPreviewHtml)
        </div>
    </section>
}

@section Scripts {
    <script src="~/js/content-metadata-editor.js" asp-append-version="true"></script>
    <script src="~/js/content-visual-editor.js" asp-append-version="true"></script>
}

@if (!document.IsNew && Model.History.Count > 0)
{
    <section class="mt-4">
        <h2 class="h5">Revision history</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Revision</th>
                        <th scope="col">Parent</th>
                        <th scope="col">Created UTC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var revision in Model.History)
                    {
                        <tr class="@(revision.RevisionId == document.ExpectedRevisionId ? "table-active" : string.Empty)">
                            <th scope="row">@revision.RevisionId</th>
                            <td>@(revision.ParentRevisionId?.ToString() ?? "Initial")</td>
                            <td>@revision.CreatedUtc.ToString("u")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
