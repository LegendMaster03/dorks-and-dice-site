@model dorks_and_dice_site.Models.Content.ContentAssetAuthoringViewModel
@{
    ViewData["Title"] = $"Media for {Model.Slug}";
    ViewData["Robots"] = "noindex, nofollow";
    var encodedSource = Uri.EscapeDataString(Model.SourceKey);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-uppercase text-muted small mb-1">@(Model.IsCentralAuthoring ? "Development" : "Editor")</p>
        <h1 class="h3 mb-0">Content media</h1>
        <p class="text-muted mb-0"><code>@Model.Slug</code> · <code>@Model.SourceKey</code></p>
    </div>
    <a class="btn btn-outline-secondary" href="@($"{Model.RouteBase}/{Model.Slug}/edit?source={encodedSource}")">Back to editor</a>
</div>

<p>Attach media before referencing its stable URL in the content body. @(Model.IsCentralAuthoring ? "Central authoring may search all configured sources." : "The mode editor is restricted to its authoring workspace.")</p>

@if (TempData["ContentMediaSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ContentMediaError"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

<form method="get" class="card card-body mb-4">
    <input type="hidden" name="source" value="@Model.SourceKey" />
    <div class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="q">Search available media</label>
            <input class="form-control" id="q" name="q" value="@Model.SearchQuery" placeholder="File name or media key" required />
            <div class="form-text">Searches media available to the current authoring surface. Results are limited for fast browsing.</div>
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" type="submit">Search media</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
{
    <h2 class="h5">Search results</h2>
    @if (Model.AvailableAssets.Count == 0)
    {
        <p class="text-muted">No unattached media matched <strong>@Model.SearchQuery</strong>.</p>
    }
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
        @foreach (var asset in Model.AvailableAssets)
        {
            var previewUrl = $"{Model.RouteBase}/{Model.Slug}/media/{asset.AssetKey}/preview?source={Uri.EscapeDataString(asset.SourceKey)}";
            <div class="col"><article class="card h-100">
                @if (asset.MediaType == "application/pdf")
                {
                    <div class="ratio ratio-4x3 border-bottom">
                        <object class="w-100 h-100" data="@previewUrl" type="application/pdf" aria-label="Preview of @asset.FileName">
                            <p class="p-3 mb-0">PDF preview is unavailable. <a href="@previewUrl" target="_blank" rel="noopener">Open PDF</a>.</p>
                        </object>
                    </div>
                    <div class="px-3 pt-3"><a href="@previewUrl" target="_blank" rel="noopener">Open PDF in a new tab</a></div>
                }
                else
                {
                    <img src="@previewUrl" class="card-img-top content-media-preview" alt="Preview of @asset.FileName" />
                }
                <div class="card-body">
                    <h3 class="h6">@asset.FileName</h3>
                    <p class="small text-muted"><code>@asset.AssetKey</code></p>
                    <form method="post" action="@($"{Model.RouteBase}/{Model.Slug}/media/attach")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="source" value="@Model.SourceKey" />
                        <input type="hidden" name="assetSource" value="@asset.SourceKey" />
                        <input type="hidden" name="assetKey" value="@asset.AssetKey" />
                        <button class="btn btn-sm btn-primary" type="submit">Add dependency</button>
                    </form>
                </div>
            </article></div>
        }
    </div>
}

@if (Model.Assets.Count == 0)
{
    <p class="text-muted">This page has no media dependencies.</p>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        @foreach (var asset in Model.Assets)
        {
            var previewUrl = $"{Model.RouteBase}/{Model.Slug}/media/{asset.AssetKey}/preview?source={Uri.EscapeDataString(asset.SourceKey)}";
            <div class="col">
                <article class="card h-100">
                    @if (asset.MediaType == "application/pdf")
                    {
                        <div class="ratio ratio-4x3 border-bottom">
                            <object class="w-100 h-100" data="@previewUrl" type="application/pdf" aria-label="Preview of @asset.FileName">
                                <p class="p-3 mb-0">PDF preview is unavailable. <a href="@previewUrl" target="_blank" rel="noopener">Open PDF</a>.</p>
                            </object>
                        </div>
                        <div class="px-3 pt-3"><a href="@previewUrl" target="_blank" rel="noopener">Open PDF in a new tab</a></div>
                    }
                    else
                    {
                        <img src="@previewUrl" class="card-img-top content-media-preview" alt="Preview of @asset.FileName" />
                    }
                    <div class="card-body">
                        <h2 class="h6">@asset.FileName</h2>
                        <p class="badge text-bg-secondary">@(asset.Relationship ?? "global")</p>
                        <dl class="row small mb-3">
                            <dt class="col-4">Type</dt>
                            <dd class="col-8">@asset.MediaType</dd>
                            <dt class="col-4">Size</dt>
                            <dd class="col-8">@($"{asset.Length / 1024.0:N1} KB")</dd>
                            <dt class="col-4">SHA-256</dt>
                            <dd class="col-8 text-break"><code>@asset.Sha256</code></dd>
                        </dl>
                        <label class="form-label" for="markdown-@asset.AssetKey">Markdown reference</label>
                        <input id="markdown-@asset.AssetKey" class="form-control font-monospace" value="@asset.MarkdownReference" readonly />
                        <div class="form-text">Use meaningful link text or image alt text before inserting the reference into the body.</div>
                        <label class="form-label mt-3" for="url-@asset.AssetKey">Stable media URL</label>
                        <input id="url-@asset.AssetKey" class="form-control font-monospace" value="@asset.Url" readonly />

                        <div class="border-top mt-3 pt-3">
                            <h3 class="h6 mb-2">Page dependencies</h3>
                            @if (asset.PageDependencies.Count == 0)
                            {
                                <p class="small text-body-secondary mb-0">No page currently owns or depends on this asset.</p>
                            }
                            else
                            {
                                <ul class="small mb-0 ps-3">
                                    @foreach (var usage in asset.PageDependencies)
                                    {
                                        <li>
                                            <code>@usage.PageSourceKey/@usage.Slug</code>
                                            <span class="text-body-secondary">(@usage.Relationship)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <form method="post"
                              action="@($"{Model.RouteBase}/{Model.Slug}/media/{asset.AssetKey}/replace")"
                              enctype="multipart/form-data"
                              class="border-top mt-3 pt-3"
                              onsubmit="return confirm('Replace the bytes behind this stable media URL? Every listed page dependency and other reference to this asset will use the new file.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="source" value="@Model.SourceKey" />
                            <input type="hidden" name="assetSource" value="@asset.SourceKey" />
                            <label class="form-label small" for="replace-page-@asset.AssetKey">Replace in place</label>
                            <input class="form-control form-control-sm"
                                   id="replace-page-@asset.AssetKey"
                                   name="file"
                                   type="file"
                                   accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/pdf"
                                   required />
                            <div class="form-text">The media type must stay <code>@asset.MediaType</code>. The stable key, file name, URL, and page references remain unchanged.</div>
                            <button class="btn btn-sm btn-outline-warning mt-2" type="submit">Replace media</button>
                        </form>

                        <form method="post" action="@($"{Model.RouteBase}/{Model.Slug}/media/detach")" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="source" value="@Model.SourceKey" />
                            <input type="hidden" name="assetKey" value="@asset.AssetKey" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove dependency</button>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
}