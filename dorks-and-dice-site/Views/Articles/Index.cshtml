@model dorks_and_dice_site.Models.Articles.ArticlesIndexViewModel
@using dorks_and_dice_site.Models.Content
@using dorks_and_dice_site.Models.Site
@{
    ViewData["Title"] = "Articles";
    ViewData["MetaTitle"] = Model.Presentation.MetaTitle;
    ViewData["MetaDescription"] = Model.Presentation.MetaDescription;
    var firstMetaImage = Model.Articles.Select(article => article.MetaImage ?? article.ListingImage?.Url).FirstOrDefault(image => !string.IsNullOrWhiteSpace(image));
    if (!string.IsNullOrWhiteSpace(firstMetaImage))
    {
        ViewData["MetaImage"] = firstMetaImage;
    }
    Func<string, string> formatTagLabel = tag => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(tag.Replace("-", " "));
}

<section class="resume-section mb-4">
    <div class="d-flex flex-column gap-2 mb-4">
        <p class="text-uppercase text-muted small mb-0">@Model.Presentation.Eyebrow</p>
        <h1 class="mb-0">@Model.Presentation.Title</h1>
        <p class="text-muted mb-0">@Model.Presentation.Description</p>
    </div>

    @if (Model.ShouldShowSearchFilter || Model.ShouldShowCategoryFilter)
    {
        <div id="articleFilters" class="article-filters mb-3" data-professional-filter="@(Model.Presentation.ForceProfessionalFilter ? "true" : "false")">
            @if (Model.ShouldShowSearchFilter)
            {
                <label class="form-label visually-hidden" for="articleSearch">Search articles</label>
                <input id="articleSearch"
                       type="search"
                       class="form-control form-control-sm article-search"
                       placeholder="Search articles or tags"
                       autocomplete="off"
                       list="articleTagSuggestions" />
                <datalist id="articleTagSuggestions">
                    @foreach (var tag in Model.Tags)
                    {
                        <option value="@tag">@formatTagLabel(tag)</option>
                    }
                </datalist>
            }
            @if (Model.ShouldShowCategoryFilter)
            {
                <div class="d-flex flex-wrap gap-2" aria-label="Article categories">
                    <button type="button" class="btn btn-sm btn-outline-secondary active" data-article-category="all">All</button>
                    @foreach (var category in Model.Categories)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-article-category="@category">@category</button>
                    }
                </div>
            }
            @if (Model.ShouldShowTagFilter)
            {
                <div class="d-flex flex-wrap gap-2" aria-label="Article tags">
                    <button type="button" class="btn btn-sm btn-outline-secondary active" data-article-tag="all">All Tags</button>
                    @foreach (var tag in Model.Tags)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-article-tag="@tag">@formatTagLabel(tag)</button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div id="articleFilters" class="d-none" data-professional-filter="@(Model.Presentation.ForceProfessionalFilter ? "true" : "false")"></div>
    }
    <p id="articleFilterStatus" class="visually-hidden" role="status" aria-live="polite"></p>

    @if (Model.Articles.Count > 0)
    {
        <div id="articleList" class="row row-cols-1 row-cols-md-2 g-4 article-list">
            @foreach (var article in Model.Articles)
            {
                var title = article.GetTitle(ContentTags.Article);
                var summary = article.GetSummary(ContentTags.Article);
                var category = article.GetCategory(ContentTags.Article) ?? string.Empty;
                var dateText = article.GetDateText(ContentTags.Article) ?? string.Empty;
                var publicTags = article.PublicTags;
                var listingStatusText = article.IsListed ? dateText : "Unlisted";
                var articleSearchText = $"{title} {summary} {category} {string.Join(' ', publicTags)}".ToLowerInvariant();
                <div class="col article-card"
                     data-article-category="@category"
                     data-article-professional="@(article.IsVisibleInMode(SiteMode.Professional) ? "true" : "false")"
                     data-article-listed="@(article.IsListed ? "true" : "false")"
                     data-article-date="@dateText.ToLowerInvariant()"
                     data-article-tags="@string.Join(' ', publicTags)"
                     data-article-title="@title.ToLowerInvariant()"
                     data-article-search="@articleSearchText">
                    <article class="card h-100 project-card-inner">
                        @if (article.ListingImage is not null)
                        {
                            <img src="@article.ListingImage.Url"
                                 class="card-img-top article-card-img"
                                 alt="@article.ListingImage.AltText"
                                 width="@article.ListingImage.Width"
                                 height="@article.ListingImage.Height" />
                        }
                        <div class="card-body">
                            <p class="featured-project-meta mb-2">@category</p>
                            <h2 class="h5 card-title">
                                <a class="stretched-link text-reset text-decoration-none"
                                   href="/articles/@article.Slug">
                                    @title
                                </a>
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(listingStatusText))
                            {
                                <p class="small text-muted mb-2">@listingStatusText</p>
                            }
                            @if (Model.IsDevelopmentPreview && !article.IsListed)
                            {
                                <p class="small text-warning-emphasis mb-2">Development preview: unlisted article</p>
                            }
                            <p class="card-text">@summary</p>
                        </div>
                    </article>
                </div>
            }
        </div>
        <div id="articleEmptyState" class="card d-none">
            <div class="card-body">
                <p class="text-muted mb-0">No articles match the selected filters.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <p class="text-muted mb-0">@Model.Presentation.EmptyStateText</p>
            </div>
        </div>
    }
</section>
