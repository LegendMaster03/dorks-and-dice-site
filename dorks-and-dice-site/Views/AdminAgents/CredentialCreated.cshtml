@model dorks_and_dice_site.Models.Operator.AdminAgentCredentialCreatedViewModel
@{
    ViewData["Title"] = Model.NewAgent ? "Agent created" : "Credential created";
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Administration</p>
    <h1 class="h2 mb-2">@(Model.NewAgent ? "Agent created" : "Credential created")</h1>
    <p class="text-body-secondary mb-0">@Model.DisplayName</p>
</div>

<div class="alert alert-warning">
    Copy this token now. It is displayed only in this response and is not stored in plaintext.
</div>

<div class="card card-body shadow-sm mb-4">
    <dl class="row">
        <dt class="col-sm-3">Agent ID</dt>
        <dd class="col-sm-9">@Model.UserId</dd>
        <dt class="col-sm-3">Credential ID</dt>
        <dd class="col-sm-9">@Model.CredentialId</dd>
        <dt class="col-sm-3">Credential name</dt>
        <dd class="col-sm-9">@Model.CredentialName</dd>
        <dt class="col-sm-3">Expires</dt>
        <dd class="col-sm-9">@(Model.ExpiresAt?.ToString() ?? "Never")</dd>
    </dl>

    <label for="operator-token" class="form-label fw-semibold">Operator token</label>
    <textarea id="operator-token"
              class="form-control font-monospace"
              rows="4"
              readonly
              spellcheck="false">@Model.Token</textarea>
</div>

<a class="btn btn-primary" href="/admin/agents/@Model.UserId">Manage agent</a>
