@model IReadOnlyList<dorks_and_dice_site.Models.Tools.ToolRegistration>
@{
    ViewData["Title"] = "Tools";
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Hosted utilities</p>
    <h1 class="h2 mb-2">Tools</h1>
    <p class="text-body-secondary mb-0">Standalone and account-aware utilities available in this site mode.</p>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No tools are currently available.</p>
}
else
{
    <div class="row g-3">
        @foreach (var tool in Model)
        {
            <div class="col-md-6 col-lg-4">
                <section class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@tool.DisplayName</h2>
                        @if (!string.IsNullOrWhiteSpace(tool.Description))
                        {
                            <p class="text-body-secondary">@tool.Description</p>
                        }
                        <a class="btn btn-primary mt-auto align-self-start" href="/tools/@tool.Slug">Open tool</a>
                    </div>
                </section>
            </div>
        }
    </div>
}
