@model dorks_and_dice_site.Models.Tools.ToolRegistration
@using dorks_and_dice_site.Models.Tools
@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Dorks & Dice tool</p>
    <h1 class="h2 mb-2">@Model.DisplayName</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-body-secondary mb-0">@Model.Description</p>
    }
</div>

@if (Model.IntegrationType == ToolIntegrationType.EmbeddedModule)
{
    <div id="dnd-tool-root" data-tool-slug="@Model.Slug" class="card card-body">
        @if (string.IsNullOrWhiteSpace(Model.UpstreamBaseUrl) || string.IsNullOrWhiteSpace(Model.FrontendEntryPoint))
        {
            <p class="mb-0 text-body-secondary">This tool is registered but its embedded module endpoint is not configured yet.</p>
        }
        else
        {
            <p class="mb-0 text-body-secondary">The embedded module is registered. Asset proxying is the next Tool Hosting implementation step.</p>
        }
    </div>
}
else
{
    <div class="card card-body">
        <p class="mb-0 text-body-secondary">This proxied application is registered. Request forwarding is the next Tool Hosting implementation step.</p>
    </div>
}
