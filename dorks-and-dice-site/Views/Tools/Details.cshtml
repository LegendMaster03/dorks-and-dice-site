@model dorks_and_dice_site.Models.Tools.ToolRegistration
@using System.Text.Json
@using dorks_and_dice_site.Models.Tools
@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Hosted tool</p>
    <h1 class="h2 mb-2">@Model.DisplayName</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-body-secondary mb-0">@Model.Description</p>
    }
</div>

@if (Model.IntegrationType == ToolIntegrationType.EmbeddedModule)
{
    <div id="tool-root" data-tool-slug="@Model.Slug">
        @if (string.IsNullOrWhiteSpace(Model.UpstreamBaseUrl) || string.IsNullOrWhiteSpace(Model.FrontendEntryPoint))
        {
            <div class="card card-body">
                <p class="mb-0 text-body-secondary">This tool is registered but its embedded module endpoint is not configured yet.</p>
            </div>
        }
        else
        {
            <div id="tool-load-status" class="card card-body" role="status" aria-live="polite">
                <p class="mb-0 text-body-secondary">Loading tool…</p>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.UpstreamBaseUrl) && !string.IsNullOrWhiteSpace(Model.FrontendEntryPoint))
    {
        var moduleUrl = $"/tool-modules/{Model.Slug}{Model.FrontendEntryPoint}";
        <script type="module">
            const toolRoot = document.getElementById("tool-root");
            const status = document.getElementById("tool-load-status");
            const moduleUrl = @Html.Raw(JsonSerializer.Serialize(moduleUrl));

            try {
                await import(moduleUrl);
                if (status?.isConnected) {
                    status.remove();
                }
            } catch (error) {
                console.error("Hosted tool module failed to load.", error);
                if (toolRoot) {
                    toolRoot.innerHTML = `
                        <div class="card card-body border-danger">
                            <h2 class="h5">Tool unavailable</h2>
                            <p class="mb-0 text-body-secondary">
                                The tool is configured but its frontend module could not be loaded. The main site is still available.
                            </p>
                        </div>`;
                }
            }
        </script>
    }
}
else
{
    <div class="card card-body">
        <p class="mb-0 text-body-secondary">This proxied application is registered. Full application request forwarding has not been implemented yet.</p>
    </div>
}
