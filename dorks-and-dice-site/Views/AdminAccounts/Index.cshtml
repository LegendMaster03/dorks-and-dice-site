@using dorks_and_dice_site.Models.Identity
@model AdminAccountListViewModel
@{
    ViewData["Title"] = "Account administration";
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Account administration</h1>
        <p class="text-body-secondary mb-0">Global and scoped authorization is managed here. Trusted access is required for this page.</p>
    </div>
    <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">Account settings</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Account</th>
                <th>Email</th>
                <th>Global roles</th>
                <th>Status</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var account in Model.Accounts)
        {
            var isLocked = account.LockoutEnd is not null && account.LockoutEnd > DateTimeOffset.UtcNow;
            <tr>
                <td>
                    <div>@account.DisplayName</div>
                    <div class="small font-monospace text-body-secondary">@account.UserId</div>
                </td>
                <td>@account.Email</td>
                <td>@(account.GlobalRoles.Count == 0 ? "—" : string.Join(", ", account.GlobalRoles))</td>
                <td>
                    @if (account.DeletedAt is not null)
                    {
                        <span class="badge text-bg-secondary">Deleted</span>
                    }
                    else if (isLocked)
                    {
                        <span class="badge text-bg-danger">Locked</span>
                    }
                    else if (!account.EmailConfirmed)
                    {
                        <span class="badge text-bg-warning">Unconfirmed</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                </td>
                <td>@account.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-userId="@account.UserId" class="btn btn-sm btn-outline-primary">Manage</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
