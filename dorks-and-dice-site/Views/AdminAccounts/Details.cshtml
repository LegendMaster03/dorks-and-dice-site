@using dorks_and_dice_site.Models.Identity
@using dorks_and_dice_site.Services.Identity
@model AdminAccountDetailViewModel
@{
    ViewData["Title"] = "Manage account";
    ViewData["Robots"] = "noindex,nofollow";
    var isDeleted = Model.DeletedAt is not null;
    var isLocked = Model.LockoutEnd is not null && Model.LockoutEnd > DateTimeOffset.UtcNow;
    var targetIsOwner = Model.GlobalRoles.Contains(AccountRoles.Owner, StringComparer.Ordinal);
    var currentUserIsOwner = User.IsInRole(AccountRoles.Owner);
    var directlyAssignedGlobalRoles = new[] { AccountRoles.Owner }
        .Concat(AccountRoles.UiAssignable)
        .Where(role => Model.GlobalRoles.Contains(role, StringComparer.Ordinal))
        .ToArray();
    var directlyAssignedScopedRoles = SiteModeEditorRoles.All
        .Where(editorRole => Model.ScopedRoles.TryGetValue(editorRole.Scope, out var roles)
            && roles.Contains(ScopedAccountRoles.Editor, StringComparer.Ordinal))
        .ToArray();
    var canOpenRoleManager = !isDeleted;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Manage account</h1>
        <div class="text-body-secondary">@Model.DisplayName</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">All accounts</a>
</div>

@if (TempData["AdminAccountMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["AdminAccountError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card card-body shadow-sm mb-4">
    <h2 class="h5">Account</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3">User ID</dt>
        <dd class="col-sm-9 font-monospace">@Model.UserId</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Email confirmed</dt>
        <dd class="col-sm-9">@(Model.EmailConfirmed ? "Yes" : "No")</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("u")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (isDeleted)
            {
                <span>Deleted @Model.DeletedAt?.ToString("u")</span>
            }
            else if (isLocked)
            {
                <span>Locked</span>
            }
            else
            {
                <span>Active</span>
            }
        </dd>
    </dl>
</div>

<div class="card card-body shadow-sm mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="h5 mb-0">Roles</h2>
        @if (canOpenRoleManager)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageRolesModal">
                Manage roles
            </button>
        }
    </div>
    <p class="text-body-secondary mt-2">Only roles directly assigned to this account are listed. Expand a global role to see inherited access.</p>

    <section class="mt-2" aria-labelledby="globalRolesHeading">
        <h3 class="h6 mb-1" id="globalRolesHeading">Global roles</h3>
        @if (directlyAssignedGlobalRoles.Length == 0)
        {
            <p class="text-body-secondary mb-0">No global roles assigned.</p>
        }
        else
        {
            @foreach (var role in directlyAssignedGlobalRoles)
            {
                var inheritedFrom = AccountRoleHierarchy.GetGlobalInheritanceSources(Model.GlobalRoles, role);
                var hierarchyNode = AccountRoleHierarchy.GetGlobalRole(role);

                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 border-top py-2">
                    <div>
                        <strong>@role</strong>
                        <div class="small text-body-secondary">
                            @if (role == AccountRoles.Owner)
                            {
                                <span>Assigned — server-managed</span>
                            }
                            else if (inheritedFrom.Count > 0)
                            {
                                <span>Assigned directly — also inherited through @string.Join(", ", inheritedFrom)</span>
                            }
                            else
                            {
                                <span>Assigned directly</span>
                            }
                        </div>
                        @if (hierarchyNode.Children.Count > 0)
                        {
                            <details class="small mt-2">
                                <summary>Inherited access</summary>
                                <ul class="mb-0 mt-1">
                                    @foreach (var child in hierarchyNode.Children)
                                    {
                                        <partial name="_RoleInheritanceNode" model="child" />
                                    }
                                </ul>
                            </details>
                        }
                    </div>
                </div>
            }
        }
    </section>

    <section class="mt-4" aria-labelledby="scopedRolesHeading">
        <h3 class="h6 mb-1" id="scopedRolesHeading">Scoped roles</h3>
        @if (directlyAssignedScopedRoles.Length == 0)
        {
            <p class="text-body-secondary mb-0">No scoped roles assigned.</p>
        }
        else
        {
            @foreach (var editorRole in directlyAssignedScopedRoles)
            {
                var inheritedFrom = AccountRoleHierarchy.GetScopedInheritanceSources(
                    Model.GlobalRoles,
                    editorRole.Scope,
                    ScopedAccountRoles.Editor);

                <div class="border-top py-2">
                    <div class="small text-body-secondary mb-1">@editorRole.DisplayName</div>
                    <div>
                        <strong>@ScopedAccountRoles.Editor</strong>
                        <div class="small text-body-secondary">
                            @if (inheritedFrom.Count > 0)
                            {
                                <span>Assigned directly — also inherited through @string.Join(", ", inheritedFrom)</span>
                            }
                            else
                            {
                                <span>Assigned directly</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</div>

@if (canOpenRoleManager)
{
    <div class="modal fade" id="manageRolesModal" tabindex="-1" aria-labelledby="manageRolesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="manageRolesModalLabel">Manage roles</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="roleSearch" class="form-label">Search roles</label>
                    <input type="search" class="form-control mb-3" id="roleSearch" placeholder="Search by role or scope" autocomplete="off" />

                    <div class="role-search-category" data-role-category>
                        <h3 class="h6">Global</h3>
                        @foreach (var role in new[] { AccountRoles.Owner }.Concat(AccountRoles.UiAssignable))
                        {
                            var assigned = Model.GlobalRoles.Contains(role, StringComparer.Ordinal);
                            var inheritedFrom = AccountRoleHierarchy.GetGlobalInheritanceSources(Model.GlobalRoles, role);
                            var ownerManaged = AccountRoles.OwnerManaged.Contains(role, StringComparer.Ordinal);
                            var canManage = role != AccountRoles.Owner
                                && (!ownerManaged || currentUserIsOwner)
                                && (!targetIsOwner || currentUserIsOwner);

                            <div class="d-flex align-items-center justify-content-between gap-2 border-top py-2" data-role-option data-role-search="global @role">
                                <div>
                                    <strong>@role</strong>
                                    @if (assigned)
                                    {
                                        <div class="small text-body-secondary">Assigned directly</div>
                                    }
                                    else if (inheritedFrom.Count > 0)
                                    {
                                        <div class="small text-body-secondary">Inherited through @string.Join(", ", inheritedFrom)</div>
                                    }
                                    else if (role == AccountRoles.Owner)
                                    {
                                        <div class="small text-body-secondary">Server-managed</div>
                                    }
                                    else if (AccountRoleHierarchy.GetGlobalRole(role).Children.Count > 0)
                                    {
                                        <div class="small text-body-secondary">Includes inherited access</div>
                                    }
                                </div>

                                @if (!canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                        @(role == AccountRoles.Owner ? "Server-managed" : "Not permitted")
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="SetGlobalRole" asp-route-userId="@Model.UserId" method="post">
                                        <input type="hidden" name="role" value="@role" />
                                        <input type="hidden" name="enabled" value="@(assigned ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(assigned ? "btn-outline-danger" : "btn-outline-primary")">
                                            @(assigned ? "Remove" : "Add")
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                    @foreach (var editorRole in SiteModeEditorRoles.All)
                    {
                        var assigned = Model.ScopedRoles.TryGetValue(editorRole.Scope, out var roles)
                            && roles.Contains(ScopedAccountRoles.Editor, StringComparer.Ordinal);
                        var inheritedFrom = AccountRoleHierarchy.GetScopedInheritanceSources(
                            Model.GlobalRoles,
                            editorRole.Scope,
                            ScopedAccountRoles.Editor);
                        var canManage = !targetIsOwner || currentUserIsOwner;

                        <div class="role-search-category mt-3" data-role-category>
                            <h3 class="h6">@editorRole.DisplayName</h3>
                            <div class="d-flex align-items-center justify-content-between gap-2 border-top py-2" data-role-option data-role-search="@editorRole.DisplayName @editorRole.Scope @ScopedAccountRoles.Editor">
                                <div>
                                    <strong>@ScopedAccountRoles.Editor</strong>
                                    @if (assigned)
                                    {
                                        <div class="small text-body-secondary">Assigned directly</div>
                                    }
                                    else if (inheritedFrom.Count > 0)
                                    {
                                        <div class="small text-body-secondary">Inherited through @string.Join(", ", inheritedFrom)</div>
                                    }
                                    else
                                    {
                                        <div class="small text-body-secondary">@editorRole.DisplayName</div>
                                    }
                                </div>

                                @if (!canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Not permitted</button>
                                }
                                else
                                {
                                    <form asp-action="SetScopedRole" asp-route-userId="@Model.UserId" method="post">
                                        <input type="hidden" name="scope" value="@editorRole.Scope" />
                                        <input type="hidden" name="role" value="@ScopedAccountRoles.Editor" />
                                        <input type="hidden" name="enabled" value="@(assigned ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(assigned ? "btn-outline-danger" : "btn-outline-primary")">
                                            @(assigned ? "Remove" : "Add")
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }

                    <p class="text-body-secondary d-none mb-0" id="roleSearchNoResults">No roles match your search.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        (() => {
            const search = document.getElementById('roleSearch');
            const noResults = document.getElementById('roleSearchNoResults');
            if (!search || !noResults) return;

            const categories = Array.from(document.querySelectorAll('[data-role-category]'));
            search.addEventListener('input', () => {
                const query = search.value.trim().toLowerCase();
                let visibleOptions = 0;

                for (const category of categories) {
                    const options = Array.from(category.querySelectorAll('[data-role-option]'));
                    let visibleInCategory = 0;

                    for (const option of options) {
                        const haystack = (option.getAttribute('data-role-search') || '').toLowerCase();
                        const visible = query.length === 0 || haystack.includes(query);
                        option.classList.toggle('d-none', !visible);
                        if (visible) visibleInCategory += 1;
                    }

                    category.classList.toggle('d-none', query.length > 0 && visibleInCategory === 0);
                    visibleOptions += visibleInCategory;
                }

                noResults.classList.toggle('d-none', query.length === 0 || visibleOptions > 0);
            });
        })();
    </script>
}

@if (!isDeleted)
{
    <div class="card card-body shadow-sm mb-4">
        <h2 class="h5">Security controls</h2>
        @if (targetIsOwner && !currentUserIsOwner)
        {
            <p class="text-body-secondary mb-0">Owner account security controls require an Owner account.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @if (isLocked)
                {
                    <form asp-action="Unlock" asp-route-userId="@Model.UserId" method="post">
                        <button type="submit" class="btn btn-outline-primary">Unlock account</button>
                    </form>
                }
                else
                {
                    <form asp-action="Lock" asp-route-userId="@Model.UserId" method="post">
                        <button type="submit" class="btn btn-outline-danger" disabled="@Model.IsCurrentUser">Lock account</button>
                    </form>
                }
                <form asp-action="InvalidateSessions" asp-route-userId="@Model.UserId" method="post">
                    <button type="submit" class="btn btn-outline-warning">Invalidate sessions</button>
                </form>
            </div>
            @if (Model.IsCurrentUser)
            {
                <div class="form-text mt-2">The current administrator can not lock its own account. Invalidating your own sessions will require you to sign in again.</div>
            }
        }
    </div>

    <div class="card card-body border-danger shadow-sm mb-4">
        <h2 class="h5 text-danger">Danger zone</h2>
        @if (targetIsOwner)
        {
            <p class="text-body-secondary mb-0">Owner accounts are server-managed and can not be deleted through the UI.</p>
        }
        else if (Model.IsCurrentUser)
        {
            <p class="text-body-secondary">Delete your own account from Account settings. You will be required to confirm your password.</p>
            <a asp-controller="Account" asp-action="Delete" class="btn btn-outline-danger align-self-start">Delete my account</a>
        }
        else
        {
            <p class="text-body-secondary">Deleting an account revokes sign-in, frees its email address, and keeps only a tombstone record. This action can not be undone.</p>
            <form asp-action="DeleteAccount" asp-route-userId="@Model.UserId" method="post"
                  onsubmit="return confirm('Delete this account? This action can not be undone.');">
                <button type="submit" class="btn btn-danger">Delete account</button>
            </form>
        }
    </div>
}