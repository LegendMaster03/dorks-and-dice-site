@using dorks_and_dice_site.Models.Identity
@using dorks_and_dice_site.Services.Identity
@model AdminAccountDetailViewModel
@{
    ViewData["Title"] = "Manage account";
    ViewData["Robots"] = "noindex,nofollow";
    var isDeleted = Model.DeletedAt is not null;
    var isLocked = Model.LockoutEnd is not null && Model.LockoutEnd > DateTimeOffset.UtcNow;
    var targetIsOwner = Model.GlobalRoles.Contains(AccountRoles.Owner, StringComparer.Ordinal);
    var currentUserIsOwner = User.IsInRole(AccountRoles.Owner);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Manage account</h1>
        <div class="text-body-secondary">@Model.DisplayName</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">All accounts</a>
</div>

@if (TempData["AdminAccountMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["AdminAccountError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card card-body shadow-sm mb-4">
    <h2 class="h5">Account</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3">User ID</dt>
        <dd class="col-sm-9 font-monospace">@Model.UserId</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Email confirmed</dt>
        <dd class="col-sm-9">@(Model.EmailConfirmed ? "Yes" : "No")</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("u")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (isDeleted)
            {
                <span>Deleted @Model.DeletedAt?.ToString("u")</span>
            }
            else if (isLocked)
            {
                <span>Locked</span>
            }
            else
            {
                <span>Active</span>
            }
        </dd>
    </dl>
</div>

<div class="card card-body shadow-sm mb-4">
    <h2 class="h5">Global roles</h2>
    <p class="text-body-secondary">Only directly assigned roles are listed as assignments. Expand any assigned role to see the live inheritance tree used by authorization.</p>

    @foreach (var role in new[] { AccountRoles.Owner }.Concat(AccountRoles.UiAssignable))
    {
        var assigned = Model.GlobalRoles.Contains(role, StringComparer.Ordinal);
        var inheritedFrom = AccountRoleHierarchy.GetGlobalInheritanceSources(Model.GlobalRoles, role);
        var showRole = role == AccountRoles.Owner || assigned || inheritedFrom.Count == 0;
        var ownerManaged = AccountRoles.OwnerManaged.Contains(role, StringComparer.Ordinal);
        var canManageRole = role != AccountRoles.Owner
            && !isDeleted
            && (!ownerManaged || currentUserIsOwner)
            && (!targetIsOwner || currentUserIsOwner);
        var hierarchyNode = AccountRoleHierarchy.GetGlobalRole(role);

        if (showRole)
        {
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 border-top py-2">
                <div>
                    @if (assigned && hierarchyNode.Children.Count > 0)
                    {
                        <details class="small">
                            <summary><strong>@role</strong></summary>
                            <div class="text-body-secondary mt-1">
                                @if (role == AccountRoles.Owner)
                                {
                                    <span>Assigned — server-managed</span>
                                }
                                else if (inheritedFrom.Count > 0)
                                {
                                    <span>Assigned directly — also inherited through @string.Join(", ", inheritedFrom)</span>
                                }
                                else
                                {
                                    <span>Assigned directly</span>
                                }
                            </div>
                            <ul class="mb-0 mt-1">
                                @foreach (var child in hierarchyNode.Children)
                                {
                                    <partial name="_RoleInheritanceNode" model="child" />
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <strong>@role</strong>
                        <div class="small text-body-secondary">
                            @if (role == AccountRoles.Owner)
                            {
                                <span>@(assigned ? "Assigned — server-managed" : "Not assigned — server-managed")</span>
                            }
                            else if (assigned && inheritedFrom.Count > 0)
                            {
                                <span>Assigned directly — also inherited through @string.Join(", ", inheritedFrom)</span>
                            }
                            else if (assigned)
                            {
                                <span>Assigned directly</span>
                            }
                            else
                            {
                                <span>Not assigned</span>
                            }
                        </div>
                    }
                </div>
                @if (canManageRole)
                {
                    <form asp-action="SetGlobalRole" asp-route-userId="@Model.UserId" method="post">
                        <input type="hidden" name="role" value="@role" />
                        <input type="hidden" name="enabled" value="@(assigned ? "false" : "true")" />
                        <button type="submit" class="btn btn-sm @(assigned ? "btn-outline-danger" : "btn-outline-primary")">
                            @(assigned ? "Remove" : "Assign")
                        </button>
                    </form>
                }
            </div>
        }
    }
</div>

<div class="card card-body shadow-sm mb-4">
    <h2 class="h5">Scoped roles</h2>
    <p class="text-body-secondary">Scoped assignments are shown separately from access inherited through global roles. Inherited-only Editor roles appear in the expandable hierarchy above rather than as direct assignments here.</p>

    @foreach (var editorRole in SiteModeEditorRoles.All)
    {
        var scope = editorRole.Scope;
        var enabled = Model.ScopedRoles.TryGetValue(scope, out var roles)
            && roles.Contains(ScopedAccountRoles.Editor, StringComparer.Ordinal);
        var inheritedFrom = AccountRoleHierarchy.GetScopedInheritanceSources(
            Model.GlobalRoles,
            scope,
            ScopedAccountRoles.Editor);
        var showScopedRole = inheritedFrom.Count == 0 || enabled;

        if (showScopedRole)
        {
            <h3 class="h6 mt-2">@editorRole.DisplayName</h3>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-top py-2">
                <div>
                    <strong>@ScopedAccountRoles.Editor</strong>
                    <div class="small text-body-secondary">
                        @if (enabled && inheritedFrom.Count > 0)
                        {
                            <span>Assigned directly — also inherited through @string.Join(", ", inheritedFrom)</span>
                        }
                        else
                        {
                            <span>@(enabled ? "Assigned directly" : "Not assigned")</span>
                        }
                    </div>
                </div>
                @if (!isDeleted && (!targetIsOwner || currentUserIsOwner))
                {
                    <form asp-action="SetScopedRole" asp-route-userId="@Model.UserId" method="post">
                        <input type="hidden" name="scope" value="@scope" />
                        <input type="hidden" name="role" value="@ScopedAccountRoles.Editor" />
                        <input type="hidden" name="enabled" value="@(enabled ? "false" : "true")" />
                        <button type="submit" class="btn btn-sm @(enabled ? "btn-outline-danger" : "btn-outline-primary")">
                            @(enabled ? "Remove" : "Assign")
                        </button>
                    </form>
                }
            </div>
        }
    }
</div>

@if (!isDeleted)
{
    <div class="card card-body shadow-sm mb-4">
        <h2 class="h5">Security controls</h2>
        @if (targetIsOwner && !currentUserIsOwner)
        {
            <p class="text-body-secondary mb-0">Owner account security controls require an Owner account.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @if (isLocked)
                {
                    <form asp-action="Unlock" asp-route-userId="@Model.UserId" method="post">
                        <button type="submit" class="btn btn-outline-primary">Unlock account</button>
                    </form>
                }
                else
                {
                    <form asp-action="Lock" asp-route-userId="@Model.UserId" method="post">
                        <button type="submit" class="btn btn-outline-danger" disabled="@Model.IsCurrentUser">Lock account</button>
                    </form>
                }
                <form asp-action="InvalidateSessions" asp-route-userId="@Model.UserId" method="post">
                    <button type="submit" class="btn btn-outline-warning">Invalidate sessions</button>
                </form>
            </div>
            @if (Model.IsCurrentUser)
            {
                <div class="form-text mt-2">The current administrator can not lock its own account. Invalidating your own sessions will require you to sign in again.</div>
            }
        }
    </div>

    <div class="card card-body border-danger shadow-sm mb-4">
        <h2 class="h5 text-danger">Danger zone</h2>
        @if (targetIsOwner)
        {
            <p class="text-body-secondary mb-0">Owner accounts are server-managed and can not be deleted through the UI.</p>
        }
        else if (Model.IsCurrentUser)
        {
            <p class="text-body-secondary">Delete your own account from Account settings. You will be required to confirm your password.</p>
            <a asp-controller="Account" asp-action="Delete" class="btn btn-outline-danger align-self-start">Delete my account</a>
        }
        else
        {
            <p class="text-body-secondary">Deleting an account revokes sign-in, frees its email address, and keeps only a tombstone record. This action can not be undone through the UI. Manual database recovery may be possible but is not guaranteed.</p>
            <form asp-action="DeleteAccount" asp-route-userId="@Model.UserId" method="post"
                  onsubmit="return confirm('Delete this account? This action can not be undone through the UI.');">
                <button type="submit" class="btn btn-danger">Delete account</button>
            </form>
        }
    </div>
}
