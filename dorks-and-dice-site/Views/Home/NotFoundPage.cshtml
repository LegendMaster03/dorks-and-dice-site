@{
    ViewData["Title"] = "Page Not Found";
}

<section class="py-4">
    <h1 class="mb-3">404 - Page Not Found</h1>
    <p class="mb-3">
        The page you requested could not be found.
    </p>
    @if (ViewData["DevelopmentModeError"] is string developmentModeError)
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5">Development mode cannot resolve this shared route</h2>
            <p class="mb-0">@developmentModeError</p>
        </div>
    }
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
    </div>
</section>
