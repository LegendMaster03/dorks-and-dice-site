@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var loginReturnUrl = ViewData["LoginReturnUrl"] as string ?? "/";
    ViewData["Title"] = isAuthenticated ? "Page Not Found" : "Page Unavailable";
    ViewData["Robots"] = "noindex,nofollow";
}

<section class="py-4">
    @if (isAuthenticated)
    {
        <h1 class="mb-3">404 - Page Not Found</h1>
        <p class="mb-3">The page you requested could not be found.</p>
    }
    else
    {
        <h1 class="mb-3">Page unavailable</h1>
        <p class="mb-3">This page may not exist, or you may need to sign in to access it.</p>
    }
    @if (ViewData["DevelopmentModeError"] is string developmentModeError)
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5">Development mode cannot resolve this shared route</h2>
            <p class="mb-0">@developmentModeError</p>
        </div>
    }
    <div class="d-flex gap-2 flex-wrap">
        @if (!isAuthenticated)
        {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@loginReturnUrl">Sign in</a>
        }
        <a class="btn @(isAuthenticated ? "btn-primary" : "btn-outline-secondary")" asp-controller="Home" asp-action="Index">Back to Home</a>
    </div>
</section>
