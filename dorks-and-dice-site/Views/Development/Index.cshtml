@{
    ViewData["Title"] = "Development";
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Development tools</p>
    <h1 class="h2 mb-2">Development</h1>
    <p class="text-body-secondary mb-0">Cross-mode composition, infrastructure, and database controls live here rather than in normal mode editors.</p>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <section class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Central Content Authoring</h2>
                <p class="text-body-secondary">Inspect and edit content across site modes and configured content sources, including cross-mode visibility assignments.</p>
                <a class="btn btn-primary mt-auto align-self-start" href="/development/content">Open central authoring</a>
            </div>
        </section>
    </div>
    <div class="col-md-6 col-lg-4">
        <section class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Content databases</h2>
                <p class="text-body-secondary">Inspect content sources and perform explicit content movement between databases.</p>
                <a class="btn btn-primary mt-auto align-self-start" href="/development/databases">Manage databases</a>
            </div>
        </section>
    </div>
    <div class="col-md-6 col-lg-4">
        <section class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Tool Hosting</h2>
                <p class="text-body-secondary">Register portable tools and configure how the host exposes them.</p>
                <a class="btn btn-primary mt-auto align-self-start" href="/development/tools">Manage tools</a>
            </div>
        </section>
    </div>
</div>
