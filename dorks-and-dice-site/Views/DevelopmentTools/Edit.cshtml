@model dorks_and_dice_site.Models.Tools.ToolRegistrationEditViewModel
@using dorks_and_dice_site.Models.Tools
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Tool" : "Register Tool";
    ViewData["Robots"] = "noindex,nofollow";
    var selectedModes = Model.Modes.ToHashSet(StringComparer.Ordinal);
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Development tools</p>
    <h1 class="h2 mb-2">@(Model.Id.HasValue ? "Edit tool" : "Register tool")</h1>
    <p class="text-body-secondary mb-0">This configures how the host presents an already available tool. Container deployment is intentionally separate.</p>
</div>

<form method="post" action="/development/tools/save" class="card card-body shadow-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="DisplayName" class="form-label">Display name</label>
            <input asp-for="DisplayName" class="form-control" />
            <div class="form-text">Human-readable name shown in tool listings and page headings.</div>
            <span asp-validation-for="DisplayName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Slug" class="form-label">Slug</label>
            <div class="input-group">
                <span class="input-group-text">/tools/</span>
                <input asp-for="Slug" class="form-control" />
            </div>
            <div class="form-text">Stable URL segment used by the host, for example <code>initiative</code>.</div>
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <div class="form-text">Optional user-facing summary of what the tool does.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="IntegrationType" class="form-label">Integration type</label>
            <select asp-for="IntegrationType" asp-items="Html.GetEnumSelectList<ToolIntegrationType>()" class="form-select"></select>
            <div class="form-text"><strong>Embedded Module</strong> mounts the tool UI inside the site's normal page shell. <strong>Proxied Application</strong> gives the tool control of <code>/tools/{slug}</code> and its subroutes.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="UpstreamBaseUrl" class="form-label">Upstream base URL</label>
            <input asp-for="UpstreamBaseUrl" class="form-control" placeholder="http://initiative:8080" />
            <div class="form-text">Internal HTTP address where the running tool can be reached. <code>localhost</code> and single-label service names such as <code>initiative</code> are allowed by default; FQDNs and literal non-loopback IPs must be explicitly allowlisted in <code>ToolHosting:AllowedUpstreamHosts</code>.</div>
            <span asp-validation-for="UpstreamBaseUrl" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FrontendEntryPoint" class="form-label">Frontend entry point</label>
            <input asp-for="FrontendEntryPoint" class="form-control" placeholder="/app.js" />
            <div class="form-text">Used only by <strong>Embedded Module</strong>. For proxied applications, leave this blank.</div>
            <span asp-validation-for="FrontendEntryPoint" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="HealthPath" class="form-label">Health path</label>
            <input asp-for="HealthPath" class="form-control" placeholder="/health" />
            <div class="form-text">Optional lightweight endpoint the host can call to verify that the tool service is running and responsive. It is combined with the upstream base URL.</div>
            <span asp-validation-for="HealthPath" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="alert alert-secondary mb-0" role="note">
                Proxied applications should serve correctly behind the public prefix <code>/tools/{slug}</code>. The host sends <code>X-Forwarded-Prefix</code>, <code>X-Forwarded-Host</code>, and <code>X-Forwarded-Proto</code>. Site cookies and authorization headers are not forwarded upstream, and upstream redirects are currently rejected rather than exposed to the browser.
            </div>
        </div>
        <div class="col-12">
            <fieldset>
                <legend class="form-label mb-2">Available site modes</legend>
                @foreach (var mode in Model.ModeOptions)
                {
                    var modeInputId = $"tool-mode-{mode.Id}";
                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@modeInputId"
                               name="Modes"
                               value="@mode.Id"
                               checked="@selectedModes.Contains(mode.Id)" />
                        <label class="form-check-label" for="@modeInputId">@mode.DisplayName</label>
                    </div>
                }
                <span asp-validation-for="Modes" class="text-danger"></span>
                <div class="form-text">A tool can be available in any registered site mode. The same <code>/tools/{slug}</code> route resolves according to the active mode.</div>
            </fieldset>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="AllowAnonymous" class="form-check-input" />
                <label asp-for="AllowAnonymous" class="form-check-label">Allow anonymous use</label>
                <div class="form-text">When enabled, visitors do not need an account to open the tool. Signed-in users can access their session and campaign membership through the host API.</div>
            </div>
            <div class="form-check mt-3">
                <input asp-for="Enabled" class="form-check-input" />
                <label asp-for="Enabled" class="form-check-label">Enable public route</label>
                <div class="form-text">Controls whether the registration is currently exposed at all. A disabled tool remains configured but returns as unavailable publicly.</div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-primary" type="submit">Save tool</button>
        <a class="btn btn-outline-secondary" href="/development/tools">Cancel</a>
    </div>
</form>
