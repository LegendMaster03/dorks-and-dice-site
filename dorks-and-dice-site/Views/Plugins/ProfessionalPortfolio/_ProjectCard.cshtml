@model dorks_and_dice_site.Models.Content.ContentItem
@using dorks_and_dice_site.Models.Content
@{
    var title = Model.GetTitle(ContentTags.Project);
    var subtitle = Model.GetSubtitle(ContentTags.Project);
    var summary = Model.GetSummary(ContentTags.Project);
    var category = Model.GetCategory(ContentTags.Project) ?? string.Empty;
    var featured = Model.IsFeatured(ContentTags.Project);
    var publicTags = Model.PublicTags;
    var categoryLabel = string.Equals(category, "professional", StringComparison.OrdinalIgnoreCase)
        ? "Professional"
        : string.Equals(category, "personal", StringComparison.OrdinalIgnoreCase)
            ? "Personal"
            : category;
    var projectLinkText = Model.GetLinkText(ContentTags.Project);
    var projectSearchText = $"{title} {subtitle} {summary} {string.Join(' ', publicTags)}".ToLowerInvariant();
}

<div class="col project-card"
     data-content-card
     data-content-category="@category"
     data-content-featured="@(featured ? "true" : "false")"
     data-content-tags="@string.Join(' ', publicTags)"
     data-content-title="@title.ToLowerInvariant()"
     data-content-search="@projectSearchText">
    <div class="card h-100 project-card-inner @(featured ? "project-card-featured" : string.Empty)">
        <div class="card-body">
            <div class="project-card-header">
                <div class="project-card-heading">
                    <div class="project-card-meta mb-2">
                        <span class="badge text-bg-light border">@categoryLabel</span>
                        @if (featured)
                        {
                            <span class="badge featured-badge">Featured</span>
                        }
                    </div>
                    <h2 class="h5 card-title">@title</h2>
                    @if (!string.IsNullOrWhiteSpace(subtitle))
                    {
                        <p class="project-card-subtitle text-muted mb-2">@subtitle</p>
                    }
                </div>
                <div class="project-card-actions">
                    <a class="btn btn-sm btn-outline-primary"
                       href="/resume/@Model.Slug"
                       aria-label="@projectLinkText: @title">
                        @projectLinkText
                    </a>
                    @if (!string.IsNullOrWhiteSpace(Model.RepositoryUrl))
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           href="@Model.RepositoryUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="View Git repository for @title (opens in a new tab)">
                            View Git
                        </a>
                    }
                </div>
            </div>
            <p class="card-text">@summary</p>
            @if (publicTags.Count > 0)
            {
                <p class="project-card-tags mb-3">
                    @foreach (var tag in publicTags)
                    {
                        <span class="badge rounded-pill text-bg-secondary-subtle text-secondary-emphasis">@tag</span>
                    }
                </p>
            }
        </div>
    </div>
</div>
