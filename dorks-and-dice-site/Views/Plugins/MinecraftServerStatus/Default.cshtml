@model dorks_and_dice_site.Plugins.MinecraftServerStatus.MinecraftServerStatus

<div class="minecraft-server-status">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <span class="badge @(Model.IsOnline ? "text-bg-success" : "text-bg-secondary")"
              data-minecraft-status-field="badge">@(Model.IsOnline ? "Online" : "Unavailable")</span>

        <span class="text-muted small"
              data-minecraft-status-field="version"
              hidden="@(!Model.IsOnline || string.IsNullOrWhiteSpace(Model.Version))">Version @Model.Version</span>
    </div>

    <p class="mb-2"
       data-minecraft-status-field="motd"
       hidden="@(!Model.IsOnline || string.IsNullOrWhiteSpace(Model.Motd))">@Model.Motd</p>

    <p class="mb-0"
       data-minecraft-status-field="players"
       hidden="@(!Model.IsOnline)">
        <strong>@(Model.OnlinePlayers ?? 0)</strong>
        of
        <strong>@(Model.MaximumPlayers?.ToString() ?? "?")</strong>
        players online
    </p>

    <p class="text-muted small mb-0"
       data-minecraft-status-field="unavailable"
       hidden="@Model.IsOnline">Live server status is temporarily unavailable.</p>
</div>
<script src="/plugins/minecraft-server-status/status.js" defer></script>
