@model dorks_and_dice_site.Models.Content.ContentAssetLibraryViewModel
@{
    ViewData["Title"] = "Media Library";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-uppercase text-muted small mb-1">Editor</p>
        <h1 class="h3 mb-0">Media library</h1>
    </div>
    <a class="btn btn-outline-secondary" href="/editor/content">Back to content</a>
</div>

<p class="text-body-secondary">Media uploaded here is stored with the active authoring workspace. Database selection is handled separately by Development tools.</p>

@if (TempData["ContentMediaSuccess"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ContentMediaError"] is string error) { <div class="alert alert-warning">@error</div> }

<form method="post" action="/editor/media/upload" enctype="multipart/form-data" class="card card-body mb-4">
    @Html.AntiForgeryToken()
    <div class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="file">Upload image</label>
            <input class="form-control" id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required />
        </div>
        <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Upload media</button></div>
    </div>
</form>

<div class="row row-cols-1 row-cols-lg-3 g-4">
@foreach (var asset in Model.Assets)
{
    <div class="col"><article class="card h-100">
        <img class="card-img-top content-media-preview" src="/editor/media/@asset.AssetKey/preview" alt="Preview of @asset.FileName" />
        <div class="card-body">
            <h2 class="h6">@asset.FileName</h2>
            <code class="small text-break">@asset.AssetKey</code>
            <input class="form-control font-monospace mt-3" value="@asset.MarkdownReference" readonly />
        </div>
    </article></div>
}
</div>
