@model dorks_and_dice_site.Models.Content.ContentAssetLibraryViewModel
@{
    ViewData["Title"] = Model.IsCentralAuthoring ? "Central Media Library" : "Media Library";
    ViewData["Robots"] = "noindex, nofollow";
    var encodedSource = Uri.EscapeDataString(Model.SourceKey);
    var contentHref = Model.IsCentralAuthoring ? "/development/content" : "/editor/content";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-uppercase text-muted small mb-1">@(Model.IsCentralAuthoring ? "Development" : "Editor")</p>
        <h1 class="h3 mb-0">@(Model.IsCentralAuthoring ? "Central media library" : "Media library")</h1>
    </div>
    <a class="btn btn-outline-secondary" href="@contentHref">Back to content</a>
</div>

@if (Model.IsCentralAuthoring)
{
    <p class="text-body-secondary">Inspect and upload media in any configured content source. Source-level media work is restricted to Development.</p>
    <form method="get" action="@Model.RouteBase" class="card card-body mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="source">Content source</label>
                <select class="form-select" id="source" name="source">
                    @foreach (var source in Model.Sources)
                    {
                        <option value="@source.Key" selected="@(string.Equals(source.Key, Model.SourceKey, StringComparison.OrdinalIgnoreCase))">@source.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-primary w-100" type="submit">Open source</button>
            </div>
        </div>
    </form>
}
else
{
    <p class="text-body-secondary">Media uploaded here is stored with the active mode's configured authoring workspace. Cross-source media management is available only from Development.</p>
}

@if (TempData["ContentMediaSuccess"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ContentMediaError"] is string error) { <div class="alert alert-warning">@error</div> }

<form method="post" action="@($"{Model.RouteBase}/upload")" enctype="multipart/form-data" class="card card-body mb-4">
    @Html.AntiForgeryToken()
    @if (Model.IsCentralAuthoring)
    {
        <input type="hidden" name="source" value="@Model.SourceKey" />
    }
    <div class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="file">Upload image or PDF</label>
            <input class="form-control" id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/pdf" required />
        </div>
        <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Upload media</button></div>
    </div>
</form>

<div class="row row-cols-1 row-cols-lg-3 g-4">
@foreach (var asset in Model.Assets)
{
    var previewHref = Model.IsCentralAuthoring
        ? $"{Model.RouteBase}/{asset.AssetKey}/preview?source={encodedSource}"
        : $"{Model.RouteBase}/{asset.AssetKey}/preview";
    <div class="col"><article class="card h-100">
        @if (asset.MediaType == "application/pdf")
        {
            <div class="ratio ratio-4x3 border-bottom">
                <object class="w-100 h-100" data="@previewHref" type="application/pdf" aria-label="Preview of @asset.FileName">
                    <p class="p-3 mb-0">PDF preview is unavailable. <a href="@previewHref" target="_blank" rel="noopener">Open PDF</a>.</p>
                </object>
            </div>
            <div class="px-3 pt-3"><a href="@previewHref" target="_blank" rel="noopener">Open PDF in a new tab</a></div>
        }
        else
        {
            <img class="card-img-top content-media-preview" src="@previewHref" alt="Preview of @asset.FileName" />
        }
        <div class="card-body">
            <h2 class="h6">@asset.FileName</h2>
            <code class="small text-break">@asset.AssetKey</code>
            <input class="form-control font-monospace mt-3" value="@asset.MarkdownReference" readonly />
        </div>
    </article></div>
}
</div>
