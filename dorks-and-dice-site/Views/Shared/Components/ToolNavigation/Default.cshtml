@model IReadOnlyList<dorks_and_dice_site.Models.Tools.ToolRegistration>

@if (Model.Count > 0)
{
    <li class="nav-item dropdown" data-site-tools-navigation>
        <button class="btn btn-link nav-link dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            Tools
        </button>
        <ul class="dropdown-menu">
            @foreach (var tool in Model)
            {
                <li>
                    <a class="dropdown-item" href="/tools/@tool.Slug">@tool.DisplayName</a>
                </li>
            }
        </ul>
    </li>
}
