@using dorks_and_dice_site.Services.Site
@using dorks_and_dice_site.Models.Site
@using Microsoft.AspNetCore.Html
@inject ISiteModePartialResolver SiteModePartialResolver
@inject ISiteModePresentationService SiteModePresentationService
@{
    var siteModeContext = Context.GetSiteModeContext();
    var isDevelopmentPreview = siteModeContext.IsDevelopmentPreview;
    var siteSuffix = SiteModePresentationService.GetTitleSuffix(siteModeContext.SiteMode);
    var pageTitle = $"{ViewData["Title"]} - {siteSuffix}";
    var metaTitle = ViewData["MetaTitle"]?.ToString() ?? pageTitle;
    var metaDescription = ViewData["MetaDescription"]?.ToString()
        ?? SiteModePresentationService.GetDefaultMetaDescription(siteModeContext.SiteMode);
    var robots = ViewData["Robots"]?.ToString();
    var defaultMetaImagePath = siteModeContext.SiteMode == SiteMode.Professional
        ? Url.Content("~/site-modes/professional/images/profile/kyle-headshot.jpg")
        : null;
    var metaImagePath = ViewData["MetaImage"]?.ToString() ?? defaultMetaImagePath;
    var metaImage = metaImagePath?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true
        ? metaImagePath
        : string.IsNullOrWhiteSpace(metaImagePath)
            ? null
            : $"{Context.Request.Scheme}://{Context.Request.Host}{metaImagePath}";
    var metaUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var returnQuery = string.Join("&", Context.Request.Query
        .Where(item => !string.Equals(item.Key, "includeUnlisted", StringComparison.OrdinalIgnoreCase))
        .SelectMany(item => item.Value.Select(value => $"{Uri.EscapeDataString(item.Key)}={Uri.EscapeDataString(value ?? string.Empty)}")));
    var currentDevelopmentPreviewReturnUrl = $"{Context.Request.Path}{(string.IsNullOrWhiteSpace(returnQuery) ? string.Empty : $"?{returnQuery}")}";
    var developmentPreviewReturnUrl = ViewData["DevelopmentPreviewReturnUrl"]?.ToString() ?? currentDevelopmentPreviewReturnUrl;
    var brandingModulePath = SiteModePartialResolver.GetBrandingModulePath(siteModeContext.SiteMode);
    var unassignedBrandingModulePath = SiteModePartialResolver.GetUnassignedBrandingModulePath();
    var developmentToolsPartialPath = "~/Views/SiteModes/Development/_DevelopmentTools.cshtml";
    var developmentTools = new DevelopmentPreviewToolbarViewModel
    {
        SelectedMode = siteModeContext.SiteMode,
        IncludeUnlistedArticles = siteModeContext.IncludeUnlistedArticles,
        RouteRestrictionMismatch = siteModeContext.DevelopmentPreviewRouteRestrictionMismatch,
        ReturnUrl = developmentPreviewReturnUrl
    };

    async Task<IHtmlContent> RenderBrandingPartAsync(SiteModeBrandingPart brandingPart)
    {
        try
        {
            return await Html.PartialAsync(brandingModulePath, brandingPart);
        }
        catch (SiteModeBrandingPartUnavailableException) when (!string.Equals(brandingModulePath, unassignedBrandingModulePath, StringComparison.Ordinal))
        {
            return await Html.PartialAsync(unassignedBrandingModulePath, brandingPart);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    @if (!string.IsNullOrWhiteSpace(robots))
    {
        <meta name="robots" content="@robots" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@metaTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@metaUrl" />
    @if (!string.IsNullOrWhiteSpace(metaImage))
    {
        <meta property="og:image" content="@metaImage" />
    }
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="@metaTitle" />
    <meta property="twitter:description" content="@metaDescription" />
    @if (!string.IsNullOrWhiteSpace(metaImage))
    {
        <meta property="twitter:image" content="@metaImage" />
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dorks_and_dice_site.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @await RenderBrandingPartAsync(SiteModeBrandingPart.Header)
        @if (isDevelopmentPreview)
        {
            @await Html.PartialAsync(developmentToolsPartialPath, developmentTools)
        }
    </header>
    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        @await RenderBrandingPartAsync(SiteModeBrandingPart.Footer)
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
