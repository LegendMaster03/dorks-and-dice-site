@using dorks_and_dice_site.Services.Site
@using dorks_and_dice_site.Services.Content.Storage
@using dorks_and_dice_site.Services.Identity
@using dorks_and_dice_site.Models.Identity
@using dorks_and_dice_site.Models.Site
@inject ISiteModePartialResolver SiteModePartialResolver
@inject ISiteModePresentationService SiteModePresentationService
@inject ISiteModeRegistry SiteModeRegistry
@inject IContentSourceRegistry ContentSourceRegistry
@inject SiteModeOptions SiteHosting
@{
    var siteModeContext = Context.GetSiteModeContext();
    var hasTrustedAccess = siteModeContext.HasTrustedAccess;
    var canUseDeveloperTools = siteModeContext.IsDevelopmentPreview;
    var siteSuffix = SiteModePresentationService.GetTitleSuffix(siteModeContext);
    var faviconPath = Url.Content(SiteModePresentationService.GetFaviconPath(siteModeContext));
    var pageTitle = $"{ViewData["Title"]} - {siteSuffix}";
    var metaTitle = ViewData["MetaTitle"]?.ToString() ?? pageTitle;
    var metaDescription = ViewData["MetaDescription"]?.ToString()
        ?? SiteModePresentationService.GetDefaultMetaDescription(siteModeContext);
    var robots = ViewData["Robots"]?.ToString();
    var canonicalHost = siteModeContext.ActiveModeId is { Length: > 0 } activeCanonicalModeId
        && SiteHosting.TryGetCanonicalHost(activeCanonicalModeId, out var configuredCanonicalHost)
            ? configuredCanonicalHost!
            : Context.Request.Host.Value;
    var canonicalOrigin = $"{Context.Request.Scheme}://{canonicalHost}";
    var canonicalUrl = $"{canonicalOrigin}{Context.Request.PathBase}{Context.Request.Path}";
    var defaultMetaImagePath = SiteModePresentationService.GetDefaultMetaImagePath(siteModeContext);
    var metaImagePath = ViewData["MetaImage"]?.ToString() ?? defaultMetaImagePath;
    var metaImage = metaImagePath?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true
        ? metaImagePath
        : string.IsNullOrWhiteSpace(metaImagePath)
            ? null
            : $"{canonicalOrigin}{metaImagePath}";
    var returnQuery = string.Join("&", Context.Request.Query
        .Where(item => !string.Equals(item.Key, "includeUnlisted", StringComparison.OrdinalIgnoreCase))
        .SelectMany(item => item.Value.Select(value => $"{Uri.EscapeDataString(item.Key)}={Uri.EscapeDataString(value ?? string.Empty)}")));
    var currentDevelopmentPreviewReturnUrl = $"{Context.Request.Path}{(string.IsNullOrWhiteSpace(returnQuery) ? string.Empty : $"?{returnQuery}")}";
    var developmentPreviewReturnUrl = ViewData["DevelopmentPreviewReturnUrl"]?.ToString() ?? currentDevelopmentPreviewReturnUrl;
    var brandingHeaderPartialPath = SiteModePartialResolver.GetBrandingPartialPath(
        siteModeContext,
        SiteModeBrandingPart.Header);
    var brandingFooterPartialPath = SiteModePartialResolver.GetBrandingPartialPath(
        siteModeContext,
        SiteModeBrandingPart.Footer);
    var developmentToolsPartialPath = $"~/Views/SiteModes/{FrameworkRuntimeStates.TrustedPreview.ViewFolder}/_DevelopmentTools.cshtml";
    var defaultSourceKeys = canUseDeveloperTools
        ? ContentSourceRegistry.GetSourcesForContext(siteModeContext)
            .Select(source => source.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var enabledSourceKeys = siteModeContext.HasContentSourceOverride
        ? siteModeContext.EnabledContentSources
        : defaultSourceKeys;
    var activeModeId = siteModeContext.ActiveModeId;
    var canPreviewUnlisted = User.Identity?.IsAuthenticated == true
        && activeModeId is not null
        && (AccountRoleHierarchy.PrincipalHasGlobalRole(User, AccountRoles.Admin)
            || AccountRoleHierarchy.PrincipalHasScopedRole(
                User,
                activeModeId,
                ScopedAccountRoles.Editor));
    var previewModeOptions = SiteModeRegistry.All
        .Select(mode => new DevelopmentPreviewModeOptionViewModel
        {
            Id = mode.Id,
            DisplayName = mode.DisplayName
        })
        .Append(new DevelopmentPreviewModeOptionViewModel
        {
            Id = FrameworkRuntimeStates.TrustedPreview.Id,
            DisplayName = FrameworkRuntimeStates.TrustedPreview.DisplayName
        })
        .ToList();
    var developmentTools = new DevelopmentPreviewToolbarViewModel
    {
        SelectedModeId = activeModeId ?? FrameworkRuntimeStates.TrustedPreview.Id,
        ModeOptions = previewModeOptions,
        CanPreviewUnlisted = canPreviewUnlisted,
        IncludeUnlistedArticles = siteModeContext.IncludeUnlistedArticles,
        RouteRestrictionMismatch = siteModeContext.DevelopmentPreviewRouteRestrictionMismatch,
        CanUseDeveloperTools = canUseDeveloperTools,
        ReturnUrl = developmentPreviewReturnUrl,
        ContentSources = canUseDeveloperTools
            ? ContentSourceRegistry.GetAllSources()
                .Select(source => new DevelopmentContentSourceToggleViewModel
                {
                    Key = source.Key,
                    DisplayName = source.DisplayName,
                    IsEnabled = enabledSourceKeys.Contains(source.Key)
                })
                .ToList()
            : []
    };
    var structuredDataJson = SiteModePresentationService.GetStructuredDataJson(
        siteModeContext,
        canonicalOrigin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <link rel="icon" href="@faviconPath" asp-append-version="true" />
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    @if (!string.IsNullOrWhiteSpace(robots))
    {
        <meta name="robots" content="@robots" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@metaTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="@siteSuffix" />
    @if (!string.IsNullOrWhiteSpace(metaImage))
    {
        <meta property="og:image" content="@metaImage" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@metaTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    @if (!string.IsNullOrWhiteSpace(metaImage))
    {
        <meta name="twitter:image" content="@metaImage" />
    }
    @if (!string.IsNullOrWhiteSpace(structuredDataJson))
    {
        <script type="application/ld+json">@Html.Raw(structuredDataJson)</script>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("_ModeStylesheets")
    <link rel="stylesheet" href="~/dorks-and-dice-site.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @await Html.PartialAsync(brandingHeaderPartialPath)
        @if (hasTrustedAccess)
        {
            @await Html.PartialAsync(developmentToolsPartialPath, developmentTools)
        }
    </header>
    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        @await Html.PartialAsync(brandingFooterPartialPath)
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>