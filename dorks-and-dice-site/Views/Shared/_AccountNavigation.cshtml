@using dorks_and_dice_site.Models.Identity
@using dorks_and_dice_site.Services.Identity
@using dorks_and_dice_site.Services.Site
@inject ISiteModeRegistry SiteModeRegistry
@inject SiteModeOptions SiteHosting
@{
    var displayName = User.FindFirst(AccountClaimTypes.DisplayName)?.Value;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var siteModeContext = Context.GetSiteModeContext();
    var showAnonymousLogin = siteModeContext.ActiveMode?.ShowAnonymousLoginInNavigation ?? true;
    var hasTrustedAccess = siteModeContext.HasTrustedAccess;
    var isAdmin = User.IsInRole(AccountRoles.Admin);
    var hasGlobalEditor = AccountRoleHierarchy.PrincipalHasGlobalRole(User, AccountRoles.GlobalEditor);
    var editorScopes = User.Claims
        .Where(claim => string.Equals(claim.Type, AccountClaimTypes.ScopedRole, StringComparison.Ordinal))
        .Select(claim => claim.Value)
        .Where(value => value.EndsWith($":{ScopedAccountRoles.Editor}", StringComparison.Ordinal))
        .Select(value => value[..value.LastIndexOf(':')])
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var editorModes = SiteModeRegistry.All
        .Where(mode => hasGlobalEditor || editorScopes.Contains(mode.Id))
        .ToList();
    var canUseEditor = editorModes.Count > 0;
    var singleEditorMode = !hasGlobalEditor && editorModes.Count == 1 ? editorModes[0] : null;
    string? singleEditorHref = null;
    if (singleEditorMode is not null)
    {
        if (string.Equals(siteModeContext.ActiveModeId, singleEditorMode.Id, StringComparison.OrdinalIgnoreCase))
        {
            singleEditorHref = "/editor/content";
        }
        else if (SiteHosting.TryGetCanonicalHost(singleEditorMode.Id, out var canonicalHost))
        {
            singleEditorHref = $"https://{canonicalHost}/editor/content";
        }
    }
    var canAdminister = hasTrustedAccess && isAdmin;
    var canUseDevelopmentTools = hasTrustedAccess && User.IsInRole(AccountRoles.Dev);
}
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item dropdown">
        <button class="btn btn-link nav-link dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            @(string.IsNullOrWhiteSpace(displayName) ? "Account" : displayName)
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="Index">Account settings</a>
            </li>
            @if (canUseEditor)
            {
                <li>
                    @if (hasTrustedAccess && singleEditorMode is not null)
                    {
                        <form method="post" action="/development-preview">
                            <input type="hidden" name="siteMode" value="@singleEditorMode.Id" />
                            <input type="hidden" name="returnUrl" value="/editor/content" />
                            <button type="submit" class="dropdown-item">Editor</button>
                        </form>
                    }
                    else
                    {
                        <a class="dropdown-item" href="@(singleEditorMode is null || singleEditorHref is null ? "/editor" : singleEditorHref)">Editor</a>
                    }
                </li>
            }
            @if (canAdminister)
            {
                <li>
                    <a class="dropdown-item" href="/admin">Admin</a>
                </li>
            }
            @if (canUseDevelopmentTools)
            {
                <li>
                    <a class="dropdown-item" href="/development">Development</a>
                </li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">Log out</button>
                </form>
            </li>
        </ul>
    </li>
}
else if (showAnonymousLogin)
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
    </li>
}
