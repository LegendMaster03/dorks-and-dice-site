@model dorks_and_dice_site.Models.Resume.CredentialEntryViewModel

<section class="card credential-card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h3 class="h5 mb-1">@Model.Title</h3>
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    <p class="text-muted mb-0">@Model.Subtitle</p>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-sm" href="@Model.OfficialUrl" target="_blank" rel="noopener noreferrer">
                    Open official credential
                </a>
                <a class="btn btn-outline-secondary btn-sm" href="@Url.Content(Model.LocalBackupUrl)" target="_blank" rel="noopener noreferrer">
                    Open local PDF backup
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p class="mb-3">@Model.Summary</p>
        }

        <div class="ratio ratio-16x9 credential-embed mb-3">
            <iframe
                src="@Model.EmbedUrl"
                title="@Model.Title"
                loading="lazy"
                referrerpolicy="no-referrer"
                allowfullscreen>
            </iframe>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <h4 class="h6 text-uppercase mb-2">Credential details</h4>
                <dl class="row mb-0 credential-details">
                    <dt class="col-sm-4">Institution</dt>
                    <dd class="col-sm-8">@Model.Institution</dd>

                    <dt class="col-sm-4">Award</dt>
                    <dd class="col-sm-8">@Model.Award</dd>

                    <dt class="col-sm-4">Issued to</dt>
                    <dd class="col-sm-8">@Model.IssuedTo</dd>

                    <dt class="col-sm-4">Date acquired</dt>
                    <dd class="col-sm-8">@Model.DateAcquired</dd>

                    <dt class="col-sm-4">Expires</dt>
                    <dd class="col-sm-8">@Model.Expires</dd>
                </dl>
            </div>
            <div class="col-lg-4">
                <div class="p-3 rounded-3 credential-backup-note h-100">
                    <h4 class="h6 text-uppercase mb-2">Backup copy</h4>
                    <p class="mb-2">The local PDF backup keeps the credential available if the external embed is blocked or unavailable.</p>
                    <p class="mb-0 small text-muted">To add another certificate, create a new `credentialEntries` record in `resume.json` and reuse this partial.</p>
                </div>
            </div>
        </div>
    </div>
</section>