@model dorks_and_dice_site.Models.Content.ContentAuthoringIndexViewModel
@using dorks_and_dice_site.Models.Content
@{
    ViewData["Title"] = Model.IsCentralAuthoring ? "Central Content Authoring" : "Content Authoring";
    ViewData["Robots"] = "noindex, nofollow";
    var mediaHref = Model.IsCentralAuthoring ? "/development/media" : "/editor/media";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-uppercase text-muted small mb-1">@(Model.IsCentralAuthoring ? "Development" : "Editor")</p>
        <h1 class="h3 mb-0">@(Model.IsCentralAuthoring ? "Central Content Authoring" : $"{Model.ModeDisplayName} Content Authoring")</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="@mediaHref">Media library</a>
        <a class="btn btn-primary" href="@($"{Model.RouteBase}/new")">New content</a>
    </div>
</div>

@if (Model.IsCentralAuthoring)
{
    <p class="text-muted">Development-only authoring across configured content sources and site modes. Use this surface for cross-mode composition and source-level work.</p>
}
else
{
    <p class="text-muted">Create and edit content for <strong>@Model.ModeDisplayName</strong>. This editor is bound to the active mode and the configured authoring workspace; cross-mode assignment is available only from Development.</p>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Contexts</th>
                <th scope="col">Source</th>
                <th scope="col">Slug</th>
                <th scope="col">Revision</th>
                <th scope="col">Listing</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                var item = entry.Item;
                var contexts = item.Tags.Where(ContentTags.IsContext).ToList();
                var detailHref = ContentPublicRoute.GetPath(item.Slug, item.Tags);
                var editHref = $"{Model.RouteBase}/{item.Slug}/edit?source={Uri.EscapeDataString(entry.SourceKey)}";
                <tr>
                    <th scope="row">@item.Title</th>
                    <td>@string.Join(", ", contexts)</td>
                    <td>
                        <span>@entry.SourceDisplayName</span>
                        @if (entry.IsAuthoringSource)
                        {
                            <span class="badge text-bg-secondary ms-1">Authoring</span>
                        }
                    </td>
                    <td><code>@item.Slug</code></td>
                    <td>@item.RevisionId</td>
                    <td>@(item.IsListed ? "Listed" : "Unlisted")</td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@detailHref">View</a>
                            <a class="btn btn-sm btn-outline-primary" href="@editHref">Edit</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
