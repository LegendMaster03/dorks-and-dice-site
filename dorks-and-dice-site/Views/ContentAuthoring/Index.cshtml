@model dorks_and_dice_site.Models.Content.ContentAuthoringIndexViewModel
@using dorks_and_dice_site.Models.Content
@{
    ViewData["Title"] = "Content Authoring";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-uppercase text-muted small mb-1">Editor</p>
        <h1 class="h3 mb-0">Content Authoring</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="/editor/media">Media library</a>
        <a class="btn btn-primary" href="/editor/content/new">New content</a>
    </div>
</div>

<p class="text-muted">Create, review, and edit content for the active site. Database selection and content transfer are available separately to Development users.</p>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Contexts</th>
                <th scope="col">Slug</th>
                <th scope="col">Revision</th>
                <th scope="col">Listing</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var contexts = item.Tags.Where(ContentTags.IsContext).ToList();
                var detailHref = item.Tags.Contains(ContentTags.Article, StringComparer.OrdinalIgnoreCase)
                    ? $"/articles/{item.Slug}"
                    : $"/resume/{item.Slug}";
                <tr>
                    <th scope="row">@item.Title</th>
                    <td>@string.Join(", ", contexts)</td>
                    <td><code>@item.Slug</code></td>
                    <td>@item.RevisionId</td>
                    <td>@(item.IsListed ? "Listed" : "Unlisted")</td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@detailHref">View</a>
                            <a class="btn btn-sm btn-outline-primary" href="/editor/content/@item.Slug/edit">Edit</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
