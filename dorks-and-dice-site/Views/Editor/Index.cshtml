@model dorks_and_dice_site.Models.Editor.EditorIndexViewModel
@{
    ViewData["Title"] = "Editor";
    ViewData["Robots"] = "noindex,nofollow";
    var mode = Model.Modes.Single();
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Content tools</p>
    <h1 class="h2 mb-2">@mode.DisplayName Editor</h1>
    <p class="text-body-secondary mb-0">This editor is bound to the active site mode. Cross-mode and cross-source authoring is available from Development in Trusted Preview.</p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <section class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@mode.DisplayName content</h2>
                <p class="text-body-secondary">Create and edit content assigned to @mode.DisplayName.</p>
                <a class="btn btn-primary mt-auto align-self-start" href="@mode.EditorHref">Open content editor</a>
            </div>
        </section>
    </div>
</div>
