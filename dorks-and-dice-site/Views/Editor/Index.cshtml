@model dorks_and_dice_site.Models.Editor.EditorIndexViewModel
@{
    ViewData["Title"] = "Editor";
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="mb-4">
    <p class="text-uppercase text-muted small mb-1">Content tools</p>
    <h1 class="h2 mb-2">Editor</h1>
    <p class="text-body-secondary mb-0">Choose a site you are authorized to edit. Administration and database management are separate tools.</p>
</div>

<div class="row g-3">
    @foreach (var mode in Model.Modes)
    {
        <div class="col-md-6">
            <section class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">@mode.DisplayName</h2>
                    <p class="text-body-secondary">Create and edit @mode.DisplayName content.</p>
                    @if (Model.IsTrustedPreview)
                    {
                        <form class="mt-auto" method="post" action="/development-preview">
                            <input type="hidden" name="siteMode" value="@mode.ModeId" />
                            <input type="hidden" name="returnUrl" value="/editor/content" />
                            <button class="btn btn-primary" type="submit">Open content editor</button>
                        </form>
                    }
                    else if (mode.EditorHref is not null)
                    {
                        <a class="btn btn-primary mt-auto align-self-start" href="@mode.EditorHref">Open content editor</a>
                    }
                    else
                    {
                        <p class="small text-muted mt-auto mb-0">No public host is configured for this site.</p>
                    }
                </div>
            </section>
        </div>
    }
</div>
