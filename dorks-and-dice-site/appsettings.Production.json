{
  "ContentStorage": {
    "Sources": {
      "External": {
        "Provider": "PostgreSQL",
        "Host": "postgres",
        "Port": 5432,
        "Database": "dorks_and_dice_content",
        "Username": "dorks_and_dice_site",
        "PasswordFile": "/run/secrets/content_db_password"
      }
    }
  },
  "IdentityStorage": {
    "Provider": "PostgreSQL",
    "Host": "postgres",
    "Port": 5432,
    "Database": "dorks_and_dice_identity",
    "Username": "dorks_and_dice_identity",
    "PasswordFile": "/run/secrets/identity_db_password",
    "ApplyMigrationsOnStartup": true
  },
  "AccountEmail": {
    "SmtpHost": "smtp.resend.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "resend",
    "PasswordFile": "/run/secrets/account_email_password",
    "FromLocalPart": "accounts"
  },
  "DataProtection": {
    "KeysPath": "/var/lib/dorks-and-dice/data-protection"
  }
}
