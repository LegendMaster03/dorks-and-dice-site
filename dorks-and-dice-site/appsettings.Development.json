{
  "ConnectionStrings": {
    "IdentityDatabase": "Data Source=Content/identity-development.db"
  },
  "ContentStorage": {
    "AuthoringSource": "Local",
    "Sources": {
      "Local": {
        "DisplayName": "Local content",
        "Provider": "Sqlite",
        "ConnectionString": "ContentDatabaseLocal"
      }
    }
  },
  "IdentityStorage": {
    "Provider": "Sqlite",
    "EnsureCreatedOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
